---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404">
	<main>
		<section class="container docs-hero">
			<hgroup>
				<h1>404</h1>
				<p>Page not found.</p>
			</hgroup>
			<p><a href={base} role="button" class="secondary">Back to home</a></p>
		</section>
	</main>
</BaseLayout>
