---
import BaseLayout from "./BaseLayout.astro";
import HomeDemo from "../components/HomeDemo.astro";
import Icon from "../components/Icon.astro";

interface Action {
	text: string;
	link: string;
	theme?: string;
}
interface Frontmatter {
	hero: {
		eyebrow?: string;
		name: string;
		text: string;
		tagline: string;
		actions: Action[];
	};
	stats?: { value: string; label: string }[];
	comparison?: {
		eyebrow: string;
		title: string;
		lede: string;
		sides: { label: string; count: string; code: string }[];
		note: string;
	};
	featuresEyebrow?: string;
	featuresTitle?: string;
	features?: { icon?: string; title: string; details: string }[];
	closing?: { text: string; actions: { text: string; link: string }[] };
}
const { frontmatter } = Astro.props as { frontmatter: Frontmatter };

const base = import.meta.env.BASE_URL;
const withBase = (link: string) => `${base}${link.replace(/^\//, "")}`;
---

<BaseLayout bodyClass="docs-home">
	<main class="docs-home">
		<section class="docs-hero-panel">
			<div class="container docs-hero">
				<div class="docs-hero-copy">
					{frontmatter.hero.eyebrow && <p class="docs-hero-eyebrow">{frontmatter.hero.eyebrow}</p>}
					<hgroup>
						<h1 class="docs-hero-title">
							<img class="docs-hero-mark docs-logo-light" src={withBase("/logo_brand.svg")} alt="" width="64" height="64" />
							<img class="docs-hero-mark docs-logo-dark" src={withBase("/logo_brand_dark.svg")} alt="" width="64" height="64" />
							<span>{frontmatter.hero.name}</span>
						</h1>
						<p>{frontmatter.hero.text}</p>
					</hgroup>
					<p class="docs-hero-tagline">{frontmatter.hero.tagline}</p>
					<p class="docs-hero-actions">
						{
							frontmatter.hero.actions.map((action) => (
								<a
									href={action.link.startsWith("http") ? action.link : withBase(action.link)}
									role="button"
									class={action.theme === "brand" ? undefined : "outline secondary"}
								>
									{action.text}
								</a>
							))
						}
					</p>
				</div>
				<HomeDemo />
			</div>
		</section>

		<div class="container">
			{
				frontmatter.stats && (
					<section class="docs-stats">
						{frontmatter.stats.map((stat) => (
							<article class="docs-stat">
								<strong class="docs-stat-value">{stat.value}</strong>
								<span class="docs-stat-label">{stat.label}</span>
							</article>
						))}
					</section>
				)
			}

			{
				frontmatter.comparison && (
					<section class="docs-compare">
						<header class="docs-section-header">
							<p class="docs-eyebrow">{frontmatter.comparison.eyebrow}</p>
							<h2>{frontmatter.comparison.title}</h2>
							<p class="docs-section-lede">{frontmatter.comparison.lede}</p>
						</header>
						<div class="docs-compare-grid">
							{frontmatter.comparison.sides.map((side) => (
								<article class="docs-compare-side">
									<header>
										<span>{side.label}</span>
										<span class="docs-compare-count">{side.count}</span>
									</header>
									<pre>
										<code set:text={side.code} />
									</pre>
								</article>
							))}
						</div>
						<p class="docs-compare-note">{frontmatter.comparison.note}</p>
					</section>
				)
			}

			<section class="docs-features">
				<header class="docs-section-header">
					<p class="docs-eyebrow">{frontmatter.featuresEyebrow}</p>
					<h2>{frontmatter.featuresTitle}</h2>
				</header>
				<dl class="docs-features-list">
					{
						(frontmatter.features ?? []).map((feature) => (
							<div class="docs-feature">
								<dt>
									{feature.icon && <Icon name={feature.icon} size={20} class="docs-feature-icon" />}
									{feature.title}
								</dt>
								<dd set:html={feature.details} />
							</div>
						))
					}
				</dl>
			</section>
		</div>

		{
			frontmatter.closing && (
				<section class="docs-closing">
					<div class="container">
						<img class="docs-closing-mark docs-logo-light" src={withBase("/logo_mono.svg")} alt="" width="40" height="40" />
						<img class="docs-closing-mark docs-logo-dark" src={withBase("/logo_mono_dark.svg")} alt="" width="40" height="40" />
						<p class="docs-closing-text">{frontmatter.closing.text}</p>
						<p class="docs-hero-actions">
							{frontmatter.closing.actions.map((action) => (
								<a href={withBase(action.link)} role="button" class="outline secondary">
									{action.text}
								</a>
							))}
						</p>
					</div>
				</section>
			)
		}
	</main>
</BaseLayout>
