---
import BaseLayout from "./BaseLayout.astro";
import { flatPages, sidebar } from "../lib/nav";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}
interface Props {
	frontmatter?: { title?: string; description?: string };
	headings?: Heading[];
}
const { frontmatter, headings = [] } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (link: string) => `${base}${link.replace(/^\//, "")}`;
// Astro's `trailingSlash: "always"` build means every page URL ends in
// "/" — normalize both sides the same way before comparing.
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const currentPath = withSlash(Astro.url.pathname);
const isActive = (link?: string) => !!link && withSlash(withBase(link)) === currentPath;
const groupHasActive = (group: { items: { link: string }[] }) =>
	group.items.some((item) => isActive(item.link));

const pageHeaders = headings.filter((h) => h.depth === 2 || h.depth === 3);

const pageIndex = flatPages.findIndex((item) => isActive(item.link));
const prevPage = pageIndex > 0 ? flatPages[pageIndex - 1] : null;
const nextPage =
	pageIndex > -1 && pageIndex < flatPages.length - 1 ? flatPages[pageIndex + 1] : null;
---

<BaseLayout title={frontmatter?.title} description={frontmatter?.description}>
	<main>
		<div class="container docs-layout">
			<aside class="docs-sidebar">
				<nav aria-label="docs navigation">
					{
						sidebar.map((group) => (
							<details open={groupHasActive(group)}>
								<summary>{group.text}</summary>
								<ul>
									{group.items.map((item) => (
										<li>
											<a href={withBase(item.link)} aria-current={isActive(item.link) ? "page" : undefined}>
												{item.text}
											</a>
										</li>
									))}
								</ul>
							</details>
						))
					}
				</nav>
			</aside>
			<div class="docs-content">
				{
					pageHeaders.length > 1 && (
						<nav class="docs-toc-top" aria-label="On this page">
							<strong>On this page</strong>
							<ul>
								{pageHeaders.map((header) => (
									<li class={`docs-toc-level-${header.depth}`}>
										<a href={`#${header.slug}`}>{header.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
				<slot />
				{
					(prevPage || nextPage) && (
						<footer class="docs-prev-next">
							{prevPage ? (
								<a href={withBase(prevPage.link)} class="secondary">
									← {prevPage.text}
								</a>
							) : (
								<span />
							)}
							{nextPage && (
								<a href={withBase(nextPage.link)} class="secondary">
									{nextPage.text} →
								</a>
							)}
						</footer>
					)
				}
			</div>
			{
				pageHeaders.length > 1 && (
					<aside class="docs-toc">
						<nav aria-label="On this page" id="docs-toc-nav">
							<strong>On this page</strong>
							<ul>
								{pageHeaders.map((header) => (
									<li class={`docs-toc-level-${header.depth}`}>
										<a href={`#${header.slug}`} data-toc-link data-slug={header.slug}>
											{header.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</aside>
				)
			}
		</div>
	</main>
</BaseLayout>

<script>
	// Scroll-spy for the "On this page" aside: highlight whichever heading
	// was most recently scrolled past. Purely additive — the TOC works
	// (and its links navigate) without this script.
	const links = Array.from(
		document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
	);
	if (links.length > 0) {
		const headings = Array.from(
			document.querySelectorAll<HTMLElement>(".docs-content :is(h2, h3)[id]"),
		);

		const update = () => {
			// 96px offset: the heading counts as "reached" slightly before it
			// touches the top edge, matching where the eye lands after a jump.
			let current = "";
			for (const heading of headings) {
				if (heading.getBoundingClientRect().top <= 96) current = heading.id;
				else break;
			}
			const activeSlug = current || headings[0]?.id || "";
			for (const link of links) {
				const active = link.dataset.slug === activeSlug;
				link.classList.toggle("docs-toc-active", active);
				if (active) link.setAttribute("aria-current", "true");
				else link.removeAttribute("aria-current");
			}
		};

		window.addEventListener("scroll", update, { passive: true });
		update();
	}
</script>
