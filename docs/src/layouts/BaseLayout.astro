---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/generated/cirth-docs.css";
import "../styles/style.css";
import { siteDescription, siteTitle } from "../lib/nav";

interface Props {
	title?: string;
	description?: string;
	bodyClass?: string;
}
const { title, description = siteDescription, bodyClass } = Astro.props;
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="icon" href={`${base}logo_brand_app.svg`} />
		<link rel="icon" href={`${base}logo_brand_app.svg`} media="(prefers-color-scheme: light)" />
		<link rel="icon" href={`${base}logo_brand_app_dark.svg`} media="(prefers-color-scheme: dark)" />
		<script is:inline>
			// Set data-theme before first paint to avoid a light-mode flash.
			(function () {
				var stored = localStorage.getItem("cirth-theme");
				var dark = stored
					? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
			})();
		</script>
	</head>
	<body class={bodyClass}>
		<SiteHeader />
		<slot />
		<SiteFooter />
		<script>
			// Copy-to-clipboard for fenced code blocks: rehype-highlight only
			// highlights, it doesn't add a button, so one is injected for every
			// `pre > code` on the page (prose fences and Demo's "Show HTML"
			// source alike).
			for (const pre of document.querySelectorAll("pre:not(.home-demo-code pre)")) {
				if (pre.querySelector(":scope > button.copy")) continue;
				const code = pre.querySelector("code");
				if (!code?.textContent) continue;

				const button = document.createElement("button");
				button.type = "button";
				button.className = "copy";
				button.setAttribute("aria-label", "Copy to clipboard");
				pre.append(button);

				button.addEventListener("click", () => {
					navigator.clipboard.writeText(code.textContent ?? "").then(() => {
						button.classList.add("copied");
						setTimeout(() => button.classList.remove("copied"), 2000);
					});
				});
			}

			// The scoped classless build reads data-theme from its own root
			// element (.cirth-classless demos), so mirror the site theme onto
			// every such wrapper whenever it changes.
			const classlessRoots = document.querySelectorAll(".cirth-classless");
			if (classlessRoots.length > 0) {
				const sync = () => {
					const theme = document.documentElement.getAttribute("data-theme");
					for (const root of classlessRoots) root.setAttribute("data-theme", theme ?? "light");
				};
				sync();
				new MutationObserver(sync).observe(document.documentElement, {
					attributeFilter: ["data-theme"],
				});
			}
		</script>
	</body>
</html>
