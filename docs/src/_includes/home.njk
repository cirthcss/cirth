---
layout: base.njk
bodyClass: docs-home-page
---
<main id="main-content" class="docs-native-home" data-pagefind-body>
	<section class="docs-native-hero" aria-labelledby="home-title">
		<div class="docs-native-grid">
			<header class="docs-native-claim">
				<h1 id="home-title">Production-ready UI<br /><em>from semantic HTML.</em></h1>
				<p class="docs-native-lede">{{ hero.tagline }}</p>
				<p class="docs-hero-actions">
					{% for action in hero.actions %}
						<a href="{{ action.link }}" role="button"{% if action.theme != "brand" %} class="secondary outline"{% endif %}>{{ action.text }}</a>
					{% endfor %}
				</p>
				<ul class="docs-primary-signals" aria-label="Primary product principles">
					<li><span>01</span><strong>Semantic HTML</strong><small>Structure carries intent.</small></li>
					<li><span>02</span><strong>Accessible baseline</strong><small>WCAG 2.2 AA checks are the floor.</small></li>
				</ul>
			</header>
			<div class="docs-native-lab">
				{% include "home-demo.njk" %}
			</div>
		</div>
	</section>

	<section class="docs-ledger" aria-labelledby="ledger-title">
		<div class="docs-native-grid">
			<header class="docs-ledger-intro">
				<h2 id="ledger-title">Claims with a check path.</h2>
				<p>{{ pitch.lede }}</p>
			</header>
			<div class="docs-ledger-table" role="table" aria-label="Cirth proof ledger">
				<div class="docs-ledger-row docs-ledger-head" role="row">
					<span role="columnheader">State</span><span role="columnheader">Claim</span><span role="columnheader">Evidence</span><span role="columnheader">Scope</span>
				</div>
				<div class="docs-ledger-row" role="row">
					<span role="cell"><i class="is-verified" aria-hidden="true">✓</i><b>verified</b></span><strong role="cell">Semantic elements first</strong><span role="cell">Element selectors + semantic demos</span><a role="cell" href="/elements">inspect</a>
				</div>
				<div class="docs-ledger-row" role="row">
					<span role="cell"><i class="is-verified" aria-hidden="true">✓</i><b>verified</b></span><strong role="cell">WCAG 2.2 AA baseline</strong><span role="cell">axe + resilience suites</span><a role="cell" href="/about#accessibility-baseline">method</a>
				</div>
				<div class="docs-ledger-row" role="row">
					<span role="cell"><i class="is-covered" aria-hidden="true">●</i><b>covered</b></span><strong role="cell">0 B distributed JavaScript</strong><span role="cell">CSS-only package output</span><a role="cell" href="/about#zero-javascript">scope</a>
				</div>
				<div class="docs-ledger-row" role="row">
					<span role="cell"><i class="is-covered" aria-hidden="true">●</i><b>covered</b></span><strong role="cell">&lt;14 KB gzipped</strong><span role="cell">Enforced budget; build fails over</span><a role="cell" href="https://github.com/cirthcss/cirth/blob/master/scripts/check-css-size.js">script</a>
				</div>
				<div class="docs-ledger-row" role="row">
					<span role="cell"><i class="is-enhanced" aria-hidden="true">+</i><b>runtime</b></span><strong role="cell">{{ proof.tokenCount }} design tokens</strong><span role="cell">Generated <code>--cirth-*</code> scan</span><a role="cell" href="/customization">override</a>
				</div>
				<div class="docs-ledger-row" role="row">
					<span role="cell"><i class="is-enhanced" aria-hidden="true">+</i><b>choice</b></span><strong role="cell">{{ proof.buildCount }} build modes</strong><span role="cell">Default / classless / scoped</span><a role="cell" href="/get-started#choose-a-build">compare</a>
				</div>
			</div>
		</div>
	</section>

	{% if stack %}
		<section class="docs-system-map" aria-labelledby="system-title">
			<div class="docs-native-grid">
				<header class="docs-system-intro">
					<h2 id="system-title">{{ stack.title }}</h2>
					<p>{{ stack.lede }}</p>
				</header>
				<ol class="docs-system-modules">
					{% for card in stack.items %}
						<li>
							<article>
								<h3>{{ card.title }}</h3>
								<p>{{ card.details | safe }}</p>
								<ul class="docs-badge-row">
									{% for badge in card.badges %}<li><code>{{ badge }}</code></li>{% endfor %}
								</ul>
							</article>
						</li>
					{% endfor %}
				</ol>
			</div>
		</section>
	{% endif %}

	{% if showcase %}
		<section class="docs-native-showcase" aria-labelledby="showcase-title">
			<div class="docs-native-grid">
				<header class="docs-showcase-intro">
					<h2 id="showcase-title">{{ showcase.title }}</h2>
					<p>{{ showcase.lede }}</p>
					<a href="{{ showcase.link }}" class="secondary">{{ showcase.linkText }} →</a>
				</header>
				<div class="docs-case-grid">
					{% for item in showcase.items %}
						<a class="docs-case" href="{{ item.link }}">
							<span class="docs-case-icon">{% icon item.icon, 32 %}</span>
							<strong>{{ item.title }}</strong>
							<span>{{ item.details }}</span>
							<small>Default UI + shell layout</small>
						</a>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{% if faq %}
		<section class="docs-native-faq" aria-labelledby="faq-title">
			<div class="docs-native-grid">
				<header>
					<h2 id="faq-title">{{ faq.title }}</h2>
				</header>
				<div class="docs-faq-list">
					{% for item in faq.items %}
						<details name="faq"><summary>{{ item.q }}</summary><p>{{ item.a | safe }}</p></details>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
</main>
