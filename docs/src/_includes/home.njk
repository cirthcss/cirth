---
layout: base.njk
bodyClass: docs-home-page
---
<main id="main-content" class="docs-native-home" data-pagefind-body>
	<section class="docs-native-hero" aria-labelledby="home-title">
		<div class="docs-native-grid">
			<header class="docs-native-claim">
				<h1 id="home-title">Production-ready UI<br />from <span class="docs-accent">semantic HTML</span>.</h1>
				<p class="docs-native-lede">{{ hero.tagline }}</p>
				<p class="docs-hero-actions">
					{% for action in hero.actions %}
						<a href="{{ action.link }}" role="button"{% if action.theme != "brand" %} class="secondary outline"{% endif %}>{{ action.text }}</a>
					{% endfor %}
				</p>
				{#- Two principles, stated. They used to be numbered 01/02, which
				    read as a metric next to a ledger of real ones further down
				    the page — a counter that counts to two is not evidence, and
				    this hero had two kinds of number in it. The labels carry the
				    point on their own. -#}
				<ul class="docs-primary-signals" aria-label="Primary product principles">
					<li><strong>Semantic HTML</strong><small>Structure carries intent.</small></li>
					<li><strong>Accessible baseline</strong><small>WCAG 2.2 AA checks are the floor.</small></li>
				</ul>
			</header>
			<div class="docs-native-lab">
				{% include "home-demo.njk" %}
			</div>
		</div>
	</section>

	<section class="docs-ledger" aria-labelledby="ledger-title">
		<div class="docs-native-grid">
			<header class="docs-ledger-intro">
				<h2 id="ledger-title">Claims with a check path.</h2>
				<p>{{ pitch.lede }}</p>
			</header>
			{#- A real table, because it is a real table. This was six <div>s
			    wearing role="table"/role="row"/role="cell", on the home page of a
			    framework whose argument is that the element is the API: the one
			    place on the site where the markup contradicted the pitch. Native
			    <thead>/<th scope>/<td> carries the same information with no ARIA
			    at all, gives every assistive technology real row and column
			    navigation instead of a re-implementation of it, and keeps working
			    if the CSS never arrives. The claim is the row's subject, so it is
			    the row header. -#}
			{#- The same scroll region every other table on this site gets
			    (eleventy.config.js wraps markdown tables in exactly this).
			    The ledger is hand-written, so it had been carrying a bare
			    `overflow-x: auto` instead: a scroll container with no
			    tabindex, no role and no name — which at 320px, where it
			    genuinely does scroll, is a scrollable region a keyboard
			    cannot reach. One treatment for "a real table that may not
			    fit", not two. -#}
			<div
				class="overflow-auto docs-table-scroll docs-ledger-table"
				tabindex="0"
				role="region"
				aria-label="Cirth proof ledger: State, Claim, Evidence, Scope"
			>
				<table>
					<caption class="sr-only">Cirth proof ledger</caption>
					<thead>
						<tr>
							<th scope="col">State</th>
							<th scope="col">Claim</th>
							<th scope="col">Evidence</th>
							<th scope="col">Scope</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="docs-ledger-state">{% icon "shield", 16, "is-verified" %}verified</td>
							<th scope="row">Semantic elements first</th>
							<td>Element selectors + semantic demos</td>
							<td><a href="/elements">inspect</a></td>
						</tr>
						<tr>
							<td class="docs-ledger-state">{% icon "shield", 16, "is-verified" %}verified</td>
							<th scope="row">WCAG 2.2 AA baseline</th>
							<td>axe + resilience suites</td>
							<td><a href="/about#accessibility-baseline">method</a></td>
						</tr>
						<tr>
							<td class="docs-ledger-state">{% icon "layers", 16, "is-covered" %}covered</td>
							<th scope="row">0 B distributed JavaScript</th>
							<td>CSS-only package output</td>
							<td><a href="/about#zero-javascript">scope</a></td>
						</tr>
						<tr>
							<td class="docs-ledger-state">{% icon "layers", 16, "is-covered" %}covered</td>
							<th scope="row">&lt;14 KB gzipped</th>
							<td>Enforced budget; build fails over</td>
							<td><a href="https://github.com/cirthcss/cirth/blob/master/scripts/check-css-size.js">script</a></td>
						</tr>
						<tr>
							<td class="docs-ledger-state">{% icon "sliders", 16, "is-enhanced" %}runtime</td>
							<th scope="row">{{ proof.tokenCount }} design tokens</th>
							<td>Generated <code>--cirth-*</code> scan</td>
							<td><a href="/customization">override</a></td>
						</tr>
						<tr>
							<td class="docs-ledger-state">{% icon "sliders", 16, "is-enhanced" %}choice</td>
							<th scope="row">{{ proof.buildCount }} build modes</th>
							<td>Default / classless / scoped</td>
							<td><a href="/get-started#choose-a-build">compare</a></td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</section>

	{% if stack %}
		<section class="docs-system-map" aria-labelledby="system-title">
			<div class="docs-native-grid">
				<header class="docs-system-intro">
					<h2 id="system-title">{{ stack.title }}</h2>
					<p>{{ stack.lede }}</p>
				</header>
				<ol class="docs-system-modules">
					{% for card in stack.items %}
						<li>
							<article>
								<h3>{{ card.title }}</h3>
								<p>{{ card.details | safe }}</p>
								<ul class="docs-badge-row">
									{% for badge in card.badges %}<li><code>{{ badge }}</code></li>{% endfor %}
								</ul>
							</article>
						</li>
					{% endfor %}
				</ol>
			</div>
		</section>
	{% endif %}

	{% if showcase %}
		<section class="docs-native-showcase" aria-labelledby="showcase-title">
			<div class="docs-native-grid">
				<header class="docs-showcase-intro">
					<h2 id="showcase-title">{{ showcase.title }}</h2>
					<p>{{ showcase.lede }}</p>
					<a href="{{ showcase.link }}" class="secondary">{{ showcase.linkText }} →</a>
				</header>
				<div class="docs-case-grid">
					{% for item in showcase.items %}
						<a class="docs-case" href="{{ item.link }}">
							<article>
								<span class="docs-case-icon">{% icon item.icon, 32 %}</span>
								<strong>{{ item.title }}</strong>
								<span>{{ item.details }}</span>
								<small>Default UI and shell layout</small>
							</article>
						</a>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{% if faq %}
		<section class="docs-native-faq" aria-labelledby="faq-title">
			<div class="docs-native-grid">
				<header>
					<h2 id="faq-title">{{ faq.title }}</h2>
				</header>
				<div class="docs-faq-list">
					{% for item in faq.items %}
						<details name="faq"><summary>{{ item.q }}</summary><p>{{ item.a | safe }}</p></details>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
</main>
