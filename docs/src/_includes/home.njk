---
layout: base.njk
bodyClass: docs-home-page
---
{% from "install.njk" import siteLink %}
{#- Each specimen is one string, rendered and highlighted from the same
    source. Flush left: whitespace in a `set` block ends up in the <pre>. -#}

{#- Also the Cirth fixture of the markup comparison (docs/benchmark/). -#}
{%- set heroSpecimen = benchmark.sources.cirth -%}

{#- Listed, rendered without any stylesheet, and rendered by Cirth. Nothing
    in it opens or changes size, so the three renderings share a footprint. -#}
{%- set storySpecimen -%}
<article>
  <hgroup>
    <h3>Lisbon to Porto</h3>
    <p>Alfa Pendular, <time datetime="2026-11-12T08:39">12 Nov, 08:39</time></p>
  </hgroup>
  <dl>
    <dt>Coach and seat</dt>
    <dd>5, seat 42 (window)</dd>
    <dt>Arrives</dt>
    <dd><time datetime="2026-11-12T11:28">11:28</time>, Porto Campanhã</dd>
  </dl>
  <label>
    Coach 5 is 70% full
    <meter value="0.7" low="0.5" high="0.8" optimum="0">70%</meter>
  </label>
  <fieldset>
    <legend>Platform alerts</legend>
    <label><input type="radio" name="alert" checked> Email</label>
    <label><input type="radio" name="alert"> Text message</label>
  </fieldset>
  <button type="button">Show ticket</button>
</article>
{%- endset %}

{%- set presetSpecimen -%}
<article>
  <label>
    Email
    <input type="email" value="ada@example.com">
  </label>
  <fieldset>
    <legend>Email me about</legend>
    <label>
      <input type="checkbox" role="switch" checked>
      Product news
    </label>
    <label>
      <input type="checkbox" role="switch" checked>
      Weekly digest
    </label>
  </fieldset>
  <footer>
    <button type="button" class="secondary">Cancel</button>
    <button type="button">Save</button>
  </footer>
</article>
{%- endset -%}

{#- Every control is live and keeps its size in every state. The cover is
    an original illustration (docs/src/images/atlas-cover.html), sized by its
    attributes so nothing moves while it loads. -#}
{%- set themeSpecimen -%}
<article>
  <figure>
    <picture>
      <source type="image/avif" srcset="/images/home/atlas-480.avif 480w, /images/home/atlas-960.avif 960w" sizes="(width >= 30rem) 23rem, calc(100vw - 5rem)">
      <img src="/images/home/atlas-480.webp" srcset="/images/home/atlas-480.webp 480w, /images/home/atlas-960.webp 960w" sizes="(width >= 30rem) 23rem, calc(100vw - 5rem)" width="480" height="160" alt="A relief map of an imaginary coast, with a route between two places" loading="lazy" decoding="async">
    </picture>
  </figure>
  <hgroup>
    <h3>Atlas 2.0 launch</h3>
    <p>On track for <time datetime="2026-11-12">12 November</time></p>
  </hgroup>
  <label>
    Launch checklist, 18 of 24
    <progress value="18" max="24"></progress>
  </label>
  <fieldset>
    <legend>Release to</legend>
    <label><input type="radio" name="release" checked> Beta testers</label>
    <label><input type="radio" name="release"> Everyone</label>
  </fieldset>
  <label>
    <input type="checkbox" checked>
    Email the subscribers
  </label>
  <footer>
    <button type="button" class="secondary">Preview</button>
    <button type="button">Ship it</button>
  </footer>
</article>
{%- endset %}

{#- The theme listing: only the declarations applied so far, a comment when
    there are none. With no script it shows them all. The sizer is the same
    listing, invisible, so the block is always as tall as its last state. -#}
{%- macro themeListing(live) -%}
<span class="hljs-selector-pseudo">:root</span> {
<span class="docs-theme-line"{% if live %} data-docs-theme-none{% endif %} hidden>  <span class="hljs-comment">/* No overrides: Cirth as it ships. */</span>
</span>{% for state in themeDemo.changes %}<span class="docs-theme-line"{% if live %} data-docs-theme-from="{{ state.id }}"{% endif %}>  <span class="hljs-attr">{{ state.changes }}</span>: {{ state.values[state.changes] }};
</span>{% endfor %}}
{%- endmacro -%}

{#- Isolated copies: the scoped build in a declarative shadow root, so the
    page's preset and theme cannot reach them and they render without a
    script. The scheme goes on the inner `.cirth`, never on the host, which
    would leave the copy without tokens. The inline rules place the copy's
    content (columns, margins, the footer's alignment) and never set a
    component's colour, type, border, radius, shadow or padding; the
    `.scheme` labels are the page's own.

    Preset copies load every preset with media="not all"; the controller
    enables one in both copies at once. -#}
{%- macro presetCopy(markup, scheme) -%}
<template shadowrootmode="open"><link rel="stylesheet" href="/styles/generated/cirth-lab-scoped.css">{% for preset in presets %}<link rel="stylesheet" href="/styles/generated/presets/{{ preset.name }}.css" media="not all" data-docs-preset="{{ preset.name }}">{% endfor %}<style>:host{display:block}.cirth{position:relative;box-sizing:border-box;min-block-size:100%;padding:3rem clamp(1rem,3vw,2rem) clamp(1rem,3vw,2rem);background:var(--cirth-canvas)}.cirth>article{margin:0}.cirth fieldset{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:1rem}.cirth fieldset>legend{grid-column:1/-1}.cirth fieldset>label{margin-block:0}.cirth article>footer{display:flex;justify-content:space-between}@media (width<30rem){.cirth fieldset{grid-template-columns:minmax(0,1fr)}}.scheme{position:absolute;inset-block-start:1rem;margin:0;color:var(--cirth-muted-color);font-size:var(--cirth-meta-font-size);font-weight:var(--cirth-font-weight-medium)}.scheme-light{inset-inline-start:clamp(1rem,3vw,2rem)}.scheme-dark{inset-inline-end:clamp(1rem,3vw,2rem)}</style><div class="cirth" data-theme="{{ scheme }}" data-docs-compare-surface><p class="scheme scheme-{{ scheme }}">{{ "Light" if scheme == "light" else "Dark" }}</p>{{ markup | safe }}</div></template>
{%- endmacro -%}

{#- The theme copy is the intentional theming demo: one <style> per state
    that declares something, the last enabled without a script; the first
    state declares nothing, so with every one off the copy is Cirth as it
    ships. Its controls are live, in the page's tab order. The canvas and
    the card's corners ease between states. -#}
{%- macro themeCopy(markup) -%}
<template shadowrootmode="open"><link rel="stylesheet" href="/styles/generated/cirth-lab-scoped.css">{% for state in themeDemo.states %}{% if state.css %}<style media="{{ 'all' if loop.last else 'not all' }}" data-docs-theme-state="{{ state.id }}">{{ state.css }}</style>{% endif %}{% endfor %}<style>:host{display:block}.cirth{box-sizing:border-box;display:grid;place-items:center;min-block-size:100%;padding:clamp(1.25rem,3vw,3rem);background:var(--cirth-canvas)}.cirth>article{inline-size:min(100%,26rem);margin:0}.cirth article>footer{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:var(--cirth-space-3)}.cirth article>footer>button{margin:0}.cirth{transition:background-color var(--docs-motion-medium,0s) var(--docs-ease-out,ease)}.cirth>article{transition:border-radius var(--docs-motion-medium,0s) var(--docs-ease-out,ease)}</style><div class="cirth" data-docs-theme-surface>{{ markup | safe }}</div></template>
{%- endmacro -%}

{#- The comparator's choices: Cirth as it ships, then each preset. -#}
{%- set compareChoices = [{ name: "default", label: "Default" }].concat(presets) -%}

{#- Orbit places, in the order frameworks.js features the marks. -#}
{%- set orbitSlots = [
  { ring: "inner", at: 300 }, { ring: "outer", at: 0 }, { ring: "outer", at: 36 },
  { ring: "inner", at: 0 }, { ring: "outer", at: 72 }, { ring: "outer", at: 108 },
  { ring: "inner", at: 60 }, { ring: "outer", at: 144 }, { ring: "outer", at: 180 },
  { ring: "inner", at: 120 }, { ring: "outer", at: 216 }, { ring: "outer", at: 252 },
  { ring: "inner", at: 180 }, { ring: "outer", at: 288 }, { ring: "inner", at: 240 },
  { ring: "outer", at: 324 }
] -%}


<main id="main-content" class="docs-home" data-pagefind-body>
	<div class="docs-aurora" aria-hidden="true"><span class="docs-aurora-warm"></span><span class="docs-aurora-cool"></span><span class="docs-aurora-gold"></span></div>

	{#- The rendered card is inert: it shows the output and is not a form. -#}
	<section class="docs-hero" aria-labelledby="home-title">
		<div class="docs-home-inner docs-hero-grid">
			<div class="docs-hero-copy">
				<h1 id="home-title">Semantic HTML in.<br />Finished UI out.</h1>
				<p class="docs-hero-lede">{{ hero.tagline }}</p>
				<p class="docs-hero-actions">
					{% for action in hero.actions %}
						<a href="{{ action.link }}" role="button"{% if action.theme != "brand" %} class="secondary outline"{% endif %}>{{ action.text }}</a>
					{% endfor %}
				</p>
				<div class="docs-hero-install docs-command">
					<p id="hero-install-label">Install from npm</p>
					<pre tabindex="0" aria-labelledby="hero-install-label"><code class="hljs language-sh">npm install @cirthcss/cirth</code></pre>
				</div>
			</div>
			<figure class="docs-hero-demo" aria-labelledby="hero-demo-caption">
				<div class="docs-hero-stack">
					<div class="docs-hero-source">
						<p class="docs-pane-label" aria-hidden="true"><code>sign-in.html</code></p>
						<pre tabindex="0" aria-label="Source of the sign-in card"><code class="hljs language-html">{{ heroSpecimen | highlight | safe }}</code></pre>
					</div>
					<div class="docs-hero-render" inert>{{ heroSpecimen | safe }}</div>
				</div>
				<figcaption id="hero-demo-caption">The markup on the left is the whole source of the card in front of it. No class, no script.</figcaption>
			</figure>
		</div>
	</section>

	{#- Each figure links to where it is measured or audited; the size is
	    read off this build (proof.size in eleventy.config.js). -#}
	<section class="docs-glance" aria-labelledby="glance-title" data-aurora="glance">
		<div class="docs-home-inner docs-glance-grid">
			<header class="docs-glance-head" data-reveal>
				<h2 id="glance-title">Measured, not promised.</h2>
				<p>Cirth is a stylesheet and nothing else: no runtime, no build step, no components to mount. Each figure here follows from that, and each one links to how it is checked.</p>
			</header>
			<dl class="docs-fact-list">
				<div data-reveal>
					<dt>JavaScript runtime</dt>
					<dd><strong>0 B</strong> <a href="/why-cirth#pure-css-nothing-to-run">Nothing to run</a></dd>
				</div>
				<div data-reveal data-reveal-delay="0.15">
					<dt>Default build, gzipped</dt>
					<dd><strong>{{ proof.size.label if proof.size else "About 15 KB" }}</strong> <a href="/about#size-and-what-it-is-a-budget-for">Measured on every build</a></dd>
				</div>
				<div data-reveal data-reveal-delay="0.3">
					<dt>Accessibility baseline</dt>
					<dd><strong>WCAG 2.2 AA</strong> <a href="/guides/accessibility#the-baseline">How it is audited</a></dd>
				</div>
				<div data-reveal data-reveal-delay="0.45">
					<dt>Stacks</dt>
					<dd><strong>Any</strong> <a href="/installation#guides">{{ frameworks.guides.length }} checked guides</a></dd>
				</div>
			</dl>
		</div>
	</section>

	{#- Steps and renderings alternate in the document, the order a phone, a
	    short window, reduced motion and no script all get. Held, the
	    controller types the listing, then brings in the browser's rendering
	    (a shadow root with no stylesheet; `all: initial` resets inherited
	    styles and serif is named because WebKit keeps the inherited face),
	    then Cirth's. -#}
	<section class="docs-story" aria-labelledby="story-title" data-docs-story data-aurora="story">
		<div class="docs-story-scene">
			<div class="docs-home-inner docs-story-grid">
				<header class="docs-story-head" data-reveal>
					<h2 id="story-title">Built on HTML, not around it.</h2>
					<p>You write the element, the browser gives it its behaviour, and Cirth gives it its look. Nothing is replaced on the way.</p>
				</header>
				<div class="docs-story-step" data-docs-story-step="1" data-reveal>
					<h3><span class="docs-story-number" aria-hidden="true">1</span> Write the element</h3>
					<p><code>&lt;time&gt;</code>, <code>&lt;dl&gt;</code>, <code>&lt;meter&gt;</code>, <code>&lt;fieldset&gt;</code>, <code>&lt;button&gt;</code>: each one says what it is, so nothing else has to. No class, no wrapper, no script.</p>
				</div>
				<figure class="docs-story-part docs-story-source" data-docs-story-part="1" data-reveal>
					<pre tabindex="0" aria-label="The markup of the ticket"><code class="hljs language-html" data-docs-story-code>{{ storySpecimen | highlight | safe }}</code><code class="hljs language-html docs-story-typed" aria-hidden="true" data-docs-story-typed></code></pre>
					<figcaption>The markup, as you write it</figcaption>
				</figure>
				<div class="docs-story-step" data-docs-story-step="2" data-reveal>
					<h3><span class="docs-story-number" aria-hidden="true">2</span> The browser brings the behaviour</h3>
					<p>It reads the times, pairs each term with its value, colours the gauge by its own good and bad ranges, keeps one alert chosen at a time and moves the choice with the arrow keys. Unstyled, it already works.</p>
				</div>
				<figure class="docs-story-part docs-story-browser" data-docs-story-part="2" data-reveal>
					<div class="docs-story-ua" inert><template shadowrootmode="open"><style>:host{display:block}.ua{all:initial;font-family:serif;display:block;color-scheme:light;background:Canvas;color:CanvasText;padding:1rem;box-sizing:border-box}</style><div class="ua">{{ storySpecimen | safe }}</div></template></div>
					<figcaption>The same markup in the browser, with no stylesheet</figcaption>
				</figure>
				<div class="docs-story-step" data-docs-story-step="3" data-reveal>
					<h3><span class="docs-story-number" aria-hidden="true">3</span> Cirth draws it</h3>
					<p>One stylesheet adds type, spacing, colour, focus and every state, in light and in dark. The markup has not changed. Pick the other alert.</p>
				</div>
				<figure class="docs-story-part docs-story-cirth" data-docs-story-part="3" data-reveal>
					<div class="docs-story-result">{{ storySpecimen | safe }}</div>
					<figcaption>The same markup, with Cirth</figcaption>
				</figure>
			</div>
		</div>
	</section>

	{#- Numbers come from docs/benchmark/results.json, checked against the
	    fixtures at build time. Bars are decorative; every value is text. -#}
	{%- set benchCirth = benchmark.implementations[0] %}
	<section class="docs-bench" aria-labelledby="bench-title" data-docs-bench data-aurora="bench">
		<div class="docs-bench-scene">
			<div class="docs-home-inner docs-bench-grid">
				<header class="docs-bench-head" data-reveal>
					<h2 id="bench-title">{{ "Less markup to maintain." if benchmark.lessMarkup else "The same card, measured twice." }}</h2>
					<p>The sign-in card at the top of this page, written twice to one brief: the same {{ benchCirth.elements }} elements, both colour schemes, a focus ring on every control, hover, pressed and invalid states. Written for Cirth, it carries no class at all.</p>
					<dl class="docs-bench-method">
						<div><dt>Counted</dt><dd>Every class name in the markup, and its bytes in UTF-8 with the whitespace collapsed.</dd></div>
						<div><dt>Not counted</dt><dd>Either stylesheet, and any build step.</dd></div>
						<div><dt>Measured</dt><dd><time datetime="{{ benchmark.measured }}">{{ benchmark.measured | longDate }}</time>, on Cirth {{ benchmark.cirthVersion }}</dd></div>
					</dl>
					<p class="docs-section-more"><a href="/why-cirth#less-markup-measured">Both versions, and how they are measured</a></p>
				</header>
				<div class="docs-bench-cards">
					{%- for metric in benchmark.metrics %}
					<article class="docs-bench-card" aria-labelledby="bench-{{ metric.id }}" data-docs-bench-card="{{ metric.id }}" data-reveal>
						<h3 id="bench-{{ metric.id }}">{{ metric.label }}</h3>
						<dl class="docs-bench-rows">
							{%- for implementation in benchmark.implementations %}
							<div data-implementation="{{ implementation.id }}">
								<dt>{{ implementation.label }}</dt>
								<dd><data value="{{ metric.values[implementation.id] }}">{{ metric.values[implementation.id] | grouped }}{% if metric.unit %}&nbsp;{{ metric.unit }}{% endif %}</data><span class="docs-bench-bar" style="--docs-share: {{ metric.shares[implementation.id] }}" aria-hidden="true"></span></dd>
							</div>
							{%- endfor %}
						</dl>
						<footer class="docs-bench-result"><strong>{{ metric.reduction }}%</strong> <span>{{ metric.result }}</span></footer>
					</article>
					{%- endfor %}
				</div>
			</div>
		</div>
	</section>

	{#- Three --cirth-* declarations change one at a time with the scroll
	    (themeDemo.js); the scroll alone changes the state. -#}
	<section class="docs-theme" aria-labelledby="theme-title" data-docs-theme data-aurora="theme">
		<div class="docs-theme-scene">
			<div class="docs-home-inner docs-theme-grid">
				<header class="docs-theme-head" data-reveal>
					<h2 id="theme-title">Your theme. Same HTML.</h2>
					<p>Every colour, radius and surface is a <code>--cirth-*</code> custom property. The card starts as Cirth ships; three of them then change, one at a time, and its markup never does. Its controls are live: hover, focus and pick, and every state follows the theme.</p>
				</header>
				<ol class="docs-theme-steps" data-reveal>
					{%- for state in themeDemo.changes %}
					<li data-docs-theme-step="{{ state.id }}"><span>{{ state.label }}</span> <code>{{ state.changes }}</code></li>
					{%- endfor %}
				</ol>
				<pre class="docs-theme-code" tabindex="0" aria-label="The declarations applied so far" data-reveal><code class="hljs language-css" data-docs-theme-listing>{{ themeListing(true) }}</code><code class="hljs language-css docs-theme-sizer" aria-hidden="true">{{ themeListing(false) }}</code></pre>
				<figure class="docs-theme-preview" data-reveal>
					<div class="docs-theme-copy">{{ themeCopy(themeSpecimen) }}</div>
					<figcaption>The same card throughout, in its own copy of Cirth, so this page's theme and preset do not reach it.</figcaption>
				</figure>
			</div>
		</div>
	</section>

	{#- Both halves are inert copies. The divider is a real range input, and
	    with no script the default preset shows split in the middle. -#}
	<section class="docs-presets" aria-labelledby="presets-title" data-aurora="presets">
		<div class="docs-home-inner docs-presets-grid">
			<header class="docs-presets-head" data-reveal>
				<h2 id="presets-title">Pick a preset. Both schemes are ready.</h2>
				<p>Start with Default, Material, Metro or Plain. Default is Cirth as it ships, and each of the others is a small token layer loaded after it. Every component reads the same tokens and every preset has coordinated light and dark schemes, so you can set a consistent visual direction quickly and switch modes without changing your HTML.</p>
				<p class="docs-presets-tagline">Same markup. Same components. Two coordinated schemes.</p>
				<p class="docs-presets-pick" data-docs-compare-pick hidden>
					<label for="compare-preset">Preset</label>
					<select id="compare-preset" data-docs-compare-preset>
						{%- for choice in compareChoices %}
						<option value="{{ choice.name }}">{{ choice.label }}</option>
						{%- endfor %}
					</select>
				</p>
				<p class="docs-presets-import" data-docs-compare-imports>
					{%- for choice in compareChoices %}
					<code data-docs-compare-import="{{ choice.name }}"{% if loop.first %} data-current{% endif %}>@import "@cirthcss/cirth";{% if choice.name != "default" %}<br>@import "@cirthcss/cirth/presets/{{ choice.name }}";{% endif %}</code>
					{%- endfor %}
				</p>
				<p class="docs-section-more"><a href="/presets">Compare every preset</a></p>
			</header>
			<figure class="docs-compare" data-docs-compare data-reveal>
				<div class="docs-compare-frame">
					<div class="docs-compare-layer docs-compare-light" inert>{{ presetCopy(presetSpecimen, "light") }}</div>
					<div class="docs-compare-layer docs-compare-dark" inert>{{ presetCopy(presetSpecimen, "dark") }}</div>
					<div class="docs-compare-divider" aria-hidden="true"><span class="docs-compare-handle"></span></div>
					<input class="docs-compare-range" type="range" min="0" max="100" step="1" value="50" aria-label="Divider between the light and the dark scheme" aria-describedby="compare-caption" aria-valuetext="Half light, half dark" data-docs-compare-range hidden>
				</div>
				<figcaption id="compare-caption">The same form twice, cut by a divider: the preset in its light scheme on the left, in its dark scheme on the right. Each half is its own copy of Cirth, so the theme and preset this page uses do not reach it.</figcaption>
			</figure>
		</div>
	</section>

	{#- Each mark links to the project's own site (see frameworks.js for the
	    terms); the rings turn only with the scroll and hold under a hand. -#}
	<section class="docs-agnostic" aria-labelledby="agnostic-title" data-docs-agnostic data-aurora="agnostic">
		<div class="docs-home-inner docs-agnostic-grid">
			<div class="docs-agnostic-field">
				<span class="docs-agnostic-core" aria-hidden="true">
					<img class="docs-logo docs-logo-light" src="/logo_brand.svg" alt="" width="64" height="64" />
					<img class="docs-logo docs-logo-dark" src="/logo_brand_dark.svg" alt="" width="64" height="64" />
				</span>
				<ul class="docs-agnostic-orbit" aria-label="Projects with a guide">
					{%- for guide in frameworks.featured %}
					{%- set slot = orbitSlots[loop.index0] %}
					<li class="docs-agnostic-{{ slot.ring }}" style="--at: {{ slot.at }}deg">{{ siteLink(guide, 40 if slot.ring == "inner" else 30, "docs-agnostic-mark") }}</li>
					{%- endfor %}
				</ul>
			</div>
			<div class="docs-agnostic-copy" data-reveal>
				<h2 id="agnostic-title">Framework agnostic. Works everywhere.</h2>
				<p>Cirth styles HTML, so it does not mind what wrote it: a JavaScript framework, a server template, a CMS, a static site generator or a desktop app.</p>
				<p>Each guide shows where the one import goes in that stack, and the one setting that keeps a build from rewriting Cirth's colours.</p>
				<p class="docs-agnostic-actions"><a href="/installation#guides" role="button">Browse all {{ frameworks.count }} guides</a></p>
			</div>
		</div>
	</section>

	{#- Closing CTA. The command uses the shell's code block, so it gets the
	    same copy control as every listing. -#}
	<section class="docs-pure" aria-labelledby="pure-title" data-aurora="pure">
		<div class="docs-home-inner docs-close">
			<p class="docs-close-eyebrow" data-reveal>Pure CSS</p>
			<h2 id="pure-title" data-reveal>Your HTML is already enough.</h2>
			<p class="docs-close-lede" data-reveal>Add Cirth once and keep the elements, behaviour and stack you already use. No component runtime and no client-side bundle to initialize.</p>
			<div class="docs-close-install docs-command" data-reveal data-reveal-delay="0.15">
				<p id="close-install-label">Install from npm</p>
				<pre tabindex="0" aria-labelledby="close-install-label"><code class="hljs language-sh">npm install @cirthcss/cirth</code></pre>
			</div>
			<p class="docs-hero-actions docs-close-actions" data-reveal data-reveal-delay="0.3">
				<a href="/installation" role="button">Get started</a>
				<a href="/examples" role="button" class="secondary outline">Browse examples</a>
			</p>
		</div>
	</section>
</main>

<script>
	// Homepage motion. A passive scroll listener queues at most one update
	// per animation frame. Each update eases the drawn scroll position
	// towards the real one and updates every section from it; the loop stops
	// when the two meet. Load, resize, fragment links and back/forward land
	// at once instead of easing.
	//
	// Without a script every section is complete in its markup. Under
	// reduced motion nothing is eased, typed or held; the controls further
	// down are wired either way.
	(() => {
		const home = document.querySelector(".docs-home");
		if (!(home instanceof HTMLElement)) return;
		const root = document.documentElement;
		const motion = matchMedia("(prefers-reduced-motion: no-preference)");
		// The same query as the full-window sections in home.css: where a
		// section can be held.
		const wide = matchMedia("screen and (width >= 64rem) and (height >= 38rem)");

		const clamp = (value) => Math.min(1, Math.max(0, value));
		/** 0 before `from`, 1 after `to`, eased in between. */
		const smoothstep = (value, [from, to]) => {
			const t = clamp((value - from) / (to - from));
			return t * t * (3 - 2 * t);
		};
		const middle = ([from, to]) => (from + to) / 2;

		// The drawn position follows the real one with a 90ms time constant,
		// so wheel steps arrive as one movement at any frame rate.
		const lag = 0.09;
		let drawnY = scrollY;
		let lastTime;
		let land = true;
		/** Real scroll minus drawn scroll: added to a measured top. */
		let behind = 0;
		const topOf = (element) => element.getBoundingClientRect().top + behind;

		/** Progress through a held section: 0 at its top, 1 at its end. */
		const getProgress = (section) => {
			const top = topOf(section);
			const travel = section.offsetHeight - innerHeight;
			return travel > 0 ? clamp(-top / travel) : top <= 0 ? 1 : 0;
		};

		// How many ascending thresholds a progress has passed. Leaving the
		// previous stage takes a sixtieth of the travel past the line, so a
		// page resting on a line does not flicker; with no previous stage the
		// lines are exact. The loop is indexed on purpose: WebKit's optimised
		// `for (… of array.entries())` crashed the page once this ran for
		// both the story and the theme.
		const margin = 1 / 60;
		const getStage = (value, thresholds, previous) => {
			let stage = 0;
			for (let index = 0; index < thresholds.length; index += 1) {
				const at = thresholds[index];
				const line = previous === undefined ? at : previous > index ? at - margin : at + margin;
				if (value < line) break;
				stage = index + 1;
			}
			return stage;
		};

		const setVars = (element, values) => {
			for (const [name, value] of Object.entries(values)) element.style.setProperty(name, value.toFixed(4));
		};
		const clearVars = (element, names) => {
			for (const name of names) element.style.removeProperty(name);
		};
		const setData = (element, name, value) => {
			if (element.dataset[name] !== value) element.dataset[name] = value;
		};

		// Story. Shares of its scroll: the listing is typed until 30%; the
		// browser's rendering comes in at 38-44% and leaves at 62-67%, crossing
		// Cirth's, which comes in at 64.5-70%. A step is reached when its
		// rendering is half in.
		const story = home.querySelector("[data-docs-story]");
		const storyAt = { typed: 0.3, browser: [0.38, 0.44], browserOut: [0.62, 0.67], cirth: [0.645, 0.7] };
		const storyLines = [middle(storyAt.browser), middle(storyAt.cirth)];
		const steps = [...(story?.querySelectorAll("[data-docs-story-step]") ?? [])];
		const typed = story?.querySelector("[data-docs-story-typed]");
		const listing = story?.querySelector("[data-docs-story-code]");
		const pieces = [];
		if (typed && listing) {
			typed.innerHTML = listing.innerHTML;
			const walker = document.createTreeWalker(typed, NodeFilter.SHOW_TEXT);
			while (walker.nextNode()) pieces.push({ node: walker.currentNode, text: walker.currentNode.data });
		}
		const total = pieces.reduce((sum, piece) => sum + piece.text.length, 0);
		let typedCount = -1;
		let storyStage;

		const type = (count) => {
			if (count === typedCount) return;
			typedCount = count;
			let left = count;
			for (const piece of pieces) {
				const take = Math.max(0, Math.min(piece.text.length, left));
				if (piece.node.data.length !== take) piece.node.data = piece.text.slice(0, take);
				left -= piece.text.length;
			}
		};

		const markSteps = (count, withCurrent) => {
			steps.forEach((step, index) => {
				step.toggleAttribute("data-reached", index < count);
				const current = withCurrent && index === count - 1;
				if (current !== step.hasAttribute("aria-current")) {
					if (current) step.setAttribute("aria-current", "step");
					else step.removeAttribute("aria-current");
				}
			});
		};

		const updateStory = (held) => {
			if (!(story instanceof HTMLElement)) return;
			if (!held) {
				type(total);
				storyStage = undefined;
				markSteps(steps.length, false);
				delete story.dataset.step;
				return;
			}
			const p = getProgress(story);
			const front = smoothstep(p, storyAt.browser);
			type(Math.round(total * clamp(p / storyAt.typed)));
			setVars(story, {
				"--docs-front": front,
				"--docs-browser": front * (1 - smoothstep(p, storyAt.browserOut)),
				"--docs-cirth": smoothstep(p, storyAt.cirth),
				"--docs-typing": p < storyAt.typed ? 1 : 0,
			});
			storyStage = getStage(p, storyLines, storyStage);
			markSteps(storyStage + 1, true);
			setData(story, "step", String(storyStage + 1));
			story.dataset.progress = p.toFixed(3);
		};

		// Benchmark. Shares of its scroll, from the section's top at 65% of the
		// window to the end of its hold: the copy, each card, its bars, then
		// its result, and the last stretch still.
		const bench = home.querySelector("[data-docs-bench]");
		const benchHead = bench?.querySelector(".docs-bench-head");
		const benchCards = [...(bench?.querySelectorAll("[data-docs-bench-card]") ?? [])];
		const benchAt = {
			head: [0, 0.2],
			cards: [[0.12, 0.48], [0.3, 0.66]],
			bars: [[0.4, 0.6], [0.56, 0.76]],
			results: [[0.62, 0.8], [0.7, 0.88]],
		};
		const cardVars = ["--docs-card", "--docs-bar", "--docs-result"];

		const updateBench = (held) => {
			if (!(bench instanceof HTMLElement)) return;
			if (!held) {
				clearVars(bench, ["--docs-head"]);
				for (const card of benchCards) clearVars(card, cardVars);
				delete bench.dataset.progress;
				return;
			}
			const start = innerHeight * 0.65;
			const end = innerHeight - bench.offsetHeight;
			const p = clamp((start - topOf(bench)) / (start - end));
			setVars(bench, { "--docs-head": smoothstep(p, benchAt.head) });
			benchCards.forEach((card, index) => {
				const at = (windows) => windows[Math.min(index, windows.length - 1)];
				setVars(card, {
					"--docs-card": smoothstep(p, at(benchAt.cards)),
					"--docs-bar": smoothstep(p, at(benchAt.bars)),
					"--docs-result": smoothstep(p, at(benchAt.results)),
				});
			});
			bench.dataset.progress = p.toFixed(3);
		};

		// Theme demo. State 0 is Cirth as it ships: every stylesheet in the
		// copy is off and the listing says there is nothing to declare. State
		// n enables its own stylesheet, lists the first n declarations and
		// marks the one that moved.
		const theme = home.querySelector("[data-docs-theme]");
		const themeRoot = theme?.querySelector(".docs-theme-copy")?.shadowRoot ?? null;
		const themeStyles = [...(themeRoot?.querySelectorAll("style[data-docs-theme-state]") ?? [])];
		const themeNone = theme?.querySelector("[data-docs-theme-none]");
		const themeDeclarations = [...(theme?.querySelectorAll("[data-docs-theme-from]") ?? [])];
		const themeSteps = [...(theme?.querySelectorAll("[data-docs-theme-step]") ?? [])];
		const stateIds = ["default", ...themeDeclarations.map((line) => line.dataset.docsThemeFrom ?? "")];
		const themeLines = [0.18, 0.4, 0.62];
		let themeStage;

		const showThemeState = (index) => {
			const id = stateIds[index];
			if (theme.dataset.state === id) return;
			for (const style of themeStyles) style.media = style.dataset.docsThemeState === id ? "all" : "not all";
			if (themeNone) themeNone.hidden = index > 0;
			themeDeclarations.forEach((line, at) => {
				line.hidden = at >= index;
				line.toggleAttribute("data-changed", at === index - 1);
			});
			themeSteps.forEach((step, at) => {
				step.toggleAttribute("data-current", at === index - 1);
				step.toggleAttribute("data-done", at < index);
			});
			theme.dataset.state = id;
		};

		const updateTheme = (held) => {
			if (!(theme instanceof HTMLElement) || themeDeclarations.length === 0) return;
			if (!held) {
				themeStage = undefined;
				showThemeState(stateIds.length - 1);
				return;
			}
			themeStage = getStage(getProgress(theme), themeLines, themeStage);
			showThemeState(Math.min(themeStage, stateIds.length - 1));
		};

		// Orbit: turns from the band entering the window to it leaving, and
		// holds while it is hovered or holds focus.
		const agnostic = home.querySelector("[data-docs-agnostic]");
		const orbit = agnostic?.querySelector(".docs-agnostic-orbit");

		const updateOrbit = (held) => {
			if (!(orbit instanceof HTMLElement) || !(agnostic instanceof HTMLElement)) return;
			if (!held) {
				orbit.style.removeProperty("--docs-orbit");
				return;
			}
			if (orbit.matches(":hover, :focus-within")) return;
			const p = clamp((innerHeight - topOf(agnostic)) / (innerHeight + agnostic.offsetHeight));
			orbit.style.setProperty("--docs-orbit", `${(p * 32 - 16).toFixed(2)}deg`);
		};

		// Aurora: each section with data-aurora names an arrangement of the
		// three glows, in the properties home.css rests them with. Between two
		// sections' middles the glows ease from one arrangement to the next.
		const glows = {
			warm: home.querySelector(".docs-aurora-warm"),
			cool: home.querySelector(".docs-aurora-cool"),
			gold: home.querySelector(".docs-aurora-gold"),
		};
		const goldHidden = { x: 50, y: 50, scale: 0.6, opacity: 0 };
		const arrangements = {
			hero: {
				warm: { x: 78, y: 38, scale: 1, opacity: 1, hue: 0 },
				cool: { x: 56, y: 76, scale: 1, opacity: 1, hue: -100 },
				gold: goldHidden,
			},
			glance: {
				warm: { x: 62, y: 74, scale: 0.95, opacity: 0.75, hue: 10 },
				cool: { x: 26, y: 30, scale: 1, opacity: 0.8, hue: -90 },
				gold: goldHidden,
			},
			story: {
				warm: { x: 86, y: 30, scale: 0.8, opacity: 0.6, hue: 0 },
				cool: { x: 20, y: 82, scale: 0.9, opacity: 0.7, hue: -100 },
				gold: goldHidden,
			},
			bench: {
				warm: { x: 24, y: 34, scale: 1.05, opacity: 0.7, hue: 20 },
				cool: { x: 80, y: 70, scale: 0.8, opacity: 0.55, hue: -120 },
				gold: { x: 60, y: 90, scale: 0.7, opacity: 0.2 },
			},
			theme: {
				warm: { x: 70, y: 22, scale: 0.9, opacity: 0.65, hue: 60 },
				cool: { x: 30, y: 80, scale: 0.85, opacity: 0.6, hue: -80 },
				gold: goldHidden,
			},
			presets: {
				warm: { x: 18, y: 70, scale: 0.85, opacity: 0.55, hue: -20 },
				cool: { x: 82, y: 26, scale: 0.9, opacity: 0.7, hue: -110 },
				gold: goldHidden,
			},
			agnostic: {
				warm: { x: 16, y: 30, scale: 1.15, opacity: 0.9, hue: -40 },
				cool: { x: 44, y: 84, scale: 1.1, opacity: 0.85, hue: -100 },
				gold: { x: 86, y: 22, scale: 1, opacity: 0.9 },
			},
			pure: {
				warm: { x: 70, y: 60, scale: 0.8, opacity: 0.4, hue: 0 },
				cool: { x: 30, y: 40, scale: 0.7, opacity: 0.35, hue: -100 },
				gold: goldHidden,
			},
		};
		const auroraSections = [...home.querySelectorAll("[data-aurora]")];

		const updateAurora = (moving) => {
			if (!moving) {
				for (const glow of Object.values(glows)) glow?.removeAttribute("style");
				return;
			}
			const middle = drawnY + innerHeight / 2;
			let from = { at: innerHeight / 2, arrangement: arrangements.hero };
			let to = from;
			for (const section of auroraSections) {
				const box = section.getBoundingClientRect();
				const anchor = { at: box.top + scrollY + box.height / 2, arrangement: arrangements[section.dataset.aurora] };
				if (anchor.at > middle) {
					to = anchor;
					break;
				}
				from = to = anchor;
			}
			const t = to === from ? 0 : smoothstep(middle, [from.at, to.at]);
			for (const [name, glow] of Object.entries(glows)) {
				const start = from.arrangement[name];
				const end = to.arrangement[name];
				const values = Object.keys(start).map((key) => [`--docs-${key}`, start[key] + (end[key] - start[key]) * t]);
				if (glow instanceof HTMLElement) setVars(glow, Object.fromEntries(values));
			}
		};

		// Reveals: outside a held section, a [data-reveal] block arrives across
		// the bottom eighth of the window; data-reveal-delay waits that much
		// more of the same distance.
		const reveals = [...home.querySelectorAll("[data-reveal]")].map((element) => ({
			element,
			delay: Number(element.dataset.revealDelay ?? 0),
			inHeld: element.closest("[data-docs-story], [data-docs-bench], [data-docs-theme]") !== null,
		}));

		const updateReveals = (moving, held) => {
			const band = innerHeight * 0.12;
			for (const { element, delay, inHeld } of reveals) {
				if (!moving || (held && inHeld)) element.style.removeProperty("--docs-arrive");
				else element.style.setProperty("--docs-arrive", clamp((innerHeight - topOf(element)) / band - delay).toFixed(3));
			}
		};

		let queued = false;
		const frame = (now) => {
			queued = false;
			const moving = motion.matches;
			const held = moving && wide.matches;
			const target = scrollY;
			if (!moving || land || now === undefined) {
				drawnY = target;
			} else {
				const seconds = lastTime === undefined ? 1 / 60 : Math.min(0.1, (now - lastTime) / 1000);
				drawnY += (target - drawnY) * (1 - Math.exp(-seconds / lag));
				if (Math.abs(target - drawnY) < 0.5) drawnY = target;
			}
			land = false;
			behind = target - drawnY;
			const settling = behind !== 0;
			lastTime = settling ? now : undefined;
			setData(home, "motion", moving ? "scroll" : "still");
			setData(home, "stage", held ? "held" : "column");
			home.toggleAttribute("data-animating", settling);
			updateAurora(moving);
			updateReveals(moving, held);
			updateStory(held);
			updateBench(held);
			updateTheme(held);
			updateOrbit(held);
			if (settling) queue();
		};
		const queue = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(frame);
		};
		const landNext = () => {
			land = true;
			queue();
		};
		addEventListener("scroll", queue, { passive: true });
		for (const event of ["resize", "hashchange", "pageshow"]) addEventListener(event, landNext, { passive: true });
		addEventListener("load", landNext, { once: true });
		motion.addEventListener("change", landNext);
		wide.addEventListener("change", landNext);
		frame();

		// The theme copy follows the page's scheme from inside its shadow root:
		// data-theme on the host would leave the copy without tokens.
		const themeSurface = themeRoot?.querySelector("[data-docs-theme-surface]");
		const followScheme = () => {
			if (themeSurface instanceof HTMLElement) themeSurface.dataset.theme = root.dataset.theme === "dark" ? "dark" : "light";
		};
		followScheme();
		new MutationObserver(followScheme).observe(root, { attributeFilter: ["data-theme"] });

		// Preset comparison: the divider and the preset list. Both are hidden
		// until wired here.
		const compare = home.querySelector("[data-docs-compare]");
		const range = compare?.querySelector("[data-docs-compare-range]");
		if (compare instanceof HTMLElement && range instanceof HTMLInputElement) {
			const describe = (value) =>
				value === 50 ? "Half light, half dark" : value === 0 ? "All dark" : value === 100 ? "All light" : `${value}% light, ${100 - value}% dark`;
			const split = () => {
				const value = Number(range.value);
				compare.style.setProperty("--docs-split", `${value}%`);
				range.setAttribute("aria-valuetext", describe(value));
			};
			range.addEventListener("input", split);
			range.hidden = false;
			split();
		}
		const preset = home.querySelector("[data-docs-compare-preset]");
		if (compare instanceof HTMLElement && preset instanceof HTMLSelectElement) {
			const copies = [...compare.querySelectorAll(".docs-compare-layer")].map((layer) => layer.shadowRoot).filter(Boolean);
			const imports = [...home.querySelectorAll("[data-docs-compare-import]")];
			const applyPreset = () => {
				for (const copy of copies) {
					for (const link of copy.querySelectorAll("link[data-docs-preset]")) link.media = link.dataset.docsPreset === preset.value ? "all" : "not all";
				}
				for (const line of imports) line.toggleAttribute("data-current", line.dataset.docsCompareImport === preset.value);
			};
			preset.addEventListener("change", applyPreset);
			home.querySelector("[data-docs-compare-pick]")?.removeAttribute("hidden");
			// A restored page keeps the list's last value.
			applyPreset();
		}
	})();
</script>
