{#- The light accent of the default theme and of each preset (themeAccents
    in eleventy.config.js), then the default theme's roles in both schemes.
    No blank lines: the page is Markdown, and one would end the HTML block. -#}
<div class="docs-colors-grid">
{%- for accent in themeAccents %}
<article class="docs-color-swatch">
<div class="docs-color-swatch-preview" style="background-color: {{ accent.color }}"><span>Aa</span></div>
<div class="docs-color-swatch-label">{{ accent.name }} ({{ accent.note }})</div>
</article>
{%- endfor %}
</div>
<section class="docs-theme-lab" aria-label="Default theme role comparison">
{%- for scheme in ["light", "dark"] %}
  <figure data-theme="{{ scheme }}">
    <figcaption><strong>{{ scheme | capitalize }}</strong><code>data-theme="{{ scheme }}"</code></figcaption>
    <div class="docs-theme-sample"><article><small>Verified state</small><h3>Semantic surface</h3><p>{{ "Canvas, card, text, border and accent signal are live theme roles." if scheme == "light" else "Dark roles are designed values, not a mathematical inversion." }}</p><button type="button">Primary action</button></article></div>
    <dl class="grid"><div><dt>Canvas</dt><dd><span class="docs-theme-role-swatch" style="background:var(--cirth-background-color)" aria-hidden="true"></span><code>--cirth-background-color</code></dd></div><div><dt>Signal</dt><dd><span class="docs-theme-role-swatch" style="background:var(--cirth-primary)" aria-hidden="true"></span><code>--cirth-primary</code></dd></div></dl>
  </figure>
{%- endfor %}
</section>
