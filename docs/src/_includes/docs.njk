---
layout: base.njk
---
{% set pageHeaders = content | headings %}
{% set pageIndex = nav.flatPages | findPageIndex(page.url) %}
<main id="main-content" class="container docs-page-shell">
	<div class="docs-mobile-tools">
		<details class="docs-mobile-nav">
			<summary>Documentation</summary>
			<nav aria-label="Mobile documentation navigation">
				{% for group in nav.sidebar %}
					<section>
						<strong>{{ group.text }}</strong>
						<ul>
							{% for item in group.items %}
								<li><a href="{{ item.link }}"{% if page.url == (item.link | withSlash) %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
							{% endfor %}
						</ul>
					</section>
				{% endfor %}
			</nav>
		</details>
		{% if pageHeaders.length > 1 %}
			<details class="docs-toc-top">
				<summary>On this page</summary>
				<nav aria-label="On this page">
					<ul>
						{% for header in pageHeaders %}
							<li class="docs-toc-level-{{ header.depth }}">
								<a href="#{{ header.slug }}">{{ header.text }}</a>
							</li>
						{% endfor %}
					</ul>
				</nav>
			</details>
		{% endif %}
	</div>
	<div class="docs-layout">
		{#- An open index, not a set of accordions: every group is visible,
		    named in the meta role, so the reader sees the whole structure
		    of the documentation and where the current page sits in it. -#}
		<aside class="docs-sidebar">
			<nav aria-label="docs navigation">
				{% for group in nav.sidebar %}
					<section class="docs-sidebar-group" aria-labelledby="docs-sidebar-{{ loop.index }}">
						<p class="docs-sidebar-label" id="docs-sidebar-{{ loop.index }}">{{ group.text }}</p>
						<ul>
							{% for item in group.items %}
								<li>
									<a href="{{ item.link }}"{% if page.url == (item.link | withSlash) %} aria-current="page"{% endif %}>{{ item.text }}</a>
								</li>
							{% endfor %}
						</ul>
					</section>
				{% endfor %}
			</nav>
		</aside>
		<div class="docs-content" data-docs-kind="{{ page.url | docsKind }}" data-pagefind-body>
			{{ (content | frameworkGuide(framework) if framework else content) | safe }}
			{% if pageIndex > -1 %}
				{% set prevPage = nav.flatPages[pageIndex - 1] if pageIndex > 0 %}
				{% set nextPage = nav.flatPages[pageIndex + 1] if pageIndex < nav.flatPages.length - 1 %}
				{% if prevPage or nextPage %}
					<nav class="docs-prev-next" aria-label="Previous and next page">
						<ul>
							{% if prevPage %}
								<li><a href="{{ prevPage.link }}" rel="prev"><small>← Previous{% if prevPage.group != nav.flatPages[pageIndex].group %} · {{ prevPage.group }}{% endif %}</small><strong>{{ prevPage.text }}</strong></a></li>
							{% endif %}
							{% if nextPage %}
								<li><a href="{{ nextPage.link }}" rel="next"><small>Next{% if nextPage.group != nav.flatPages[pageIndex].group %} · {{ nextPage.group }}{% endif %} →</small><strong>{{ nextPage.text }}</strong></a></li>
							{% endif %}
						</ul>
					</nav>
				{% endif %}
			{% endif %}
		</div>
		{% if pageHeaders.length > 1 %}
			<aside class="docs-toc">
				<nav aria-label="On this page" id="docs-toc-nav">
					<strong>On this page</strong>
					<ul>
						{% for header in pageHeaders %}
							<li class="docs-toc-level-{{ header.depth }}">
								<a href="#{{ header.slug }}" data-toc-link data-slug="{{ header.slug }}">{{ header.text }}</a>
							</li>
						{% endfor %}
					</ul>
				</nav>
			</aside>
		{% endif %}
	</div>
</main>
<script>
	// Scroll-spy for the "On this page" aside: highlight whichever heading
	// was most recently scrolled past. Purely additive: the TOC works
	// (and its links navigate) without this script.
	const links = Array.from(document.querySelectorAll("[data-toc-link]"));
	if (links.length > 0) {
		const headings = Array.from(
			document.querySelectorAll(".docs-content :is(h2, h3)[id]"),
		);

		const update = () => {
			// 96px offset: the heading counts as "reached" slightly before it
			// touches the top edge, matching where the eye lands after a jump.
			let current = "";
			for (const heading of headings) {
				if (heading.getBoundingClientRect().top <= 96) current = heading.id;
				else break;
			}
			const activeSlug = current || (headings[0] ? headings[0].id : "");
			// aria-current only: the framework paints its one registered
			// edge on the inline-start rail from it, and the stylesheet
			// deliberately adds no second marker of its own.
			for (const link of links) {
				if (link.dataset.slug === activeSlug) {
					link.setAttribute("aria-current", "true");
				} else {
					link.removeAttribute("aria-current");
				}
			}
		};

		window.addEventListener("scroll", update, { passive: true });
		update();
	}
</script>
