<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{ labLabel }} build — authentic Cirth output</title>
		<script>
			// Documentation-only enhancement: the stylesheet below remains the
			// real Cirth build and the complete UI is readable without JavaScript.
			// This script only mirrors the requested light/dark scheme before paint.
			(function () {
				var requested = new URLSearchParams(location.search).get("theme");
				document.documentElement.setAttribute(
					"data-theme",
					requested === "dark" ? "dark" : "light",
				);
			})();
		</script>
		<link rel="stylesheet" href="/styles/generated/{{ labStylesheet }}" />
		{%- if labScoped %}
		{#- A scoped build styles only .cirth, so inside a frame the wrapper is
		    made full-bleed to avoid the browser's white margin around it. -#}
		<style>
			body { margin: 0; }
			.cirth { min-block-size: 100vh; }
		</style>
		{%- endif %}
	</head>
	{#- inert: these pages are embedded as pictures (examples page). The
	    iframe title describes them; the sample form never enters the host's
	    tab order. -#}
	<body inert>
		{% if labScoped %}<div class="cirth">{% endif %}
		<main{% if not labClassless %} class="container"{% endif %}>
			<article>
				<h2>Sign in</h2>
				<form>
					<label>
						Email
						<input type="email" name="email" autocomplete="email" required />
					</label>
					<label>
						Password
						<input type="password" name="password" autocomplete="current-password" required />
					</label>
					<label><input type="checkbox" checked /> Remember me</label>
					<button>Sign in</button>
				</form>
			</article>
		</main>
		{% if labScoped %}</div>
		<script>
			// A scoped build reads data-theme off the .cirth element itself,
			// not off <html> (see the Themes page), so the requested scheme is
			// mirrored onto the wrapper as well.
			document.querySelector(".cirth").setAttribute(
				"data-theme",
				document.documentElement.getAttribute("data-theme"),
			);
		</script>{% endif %}
	</body>
</html>
