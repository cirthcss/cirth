{#- A page is titled by its own <h1> unless front matter names one, so
    every tab and every navigation announces the page (WCAG 2.4.2). -#}
{%- set pageTitle = title or (content | firstHeading if page.url != "/" else "") -%}
<!doctype html>
<html lang="en" data-base="{{ '/' | htmlBaseUrl }}">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{% if pageTitle %}{{ pageTitle }} — {{ nav.siteTitle }}{% else %}{{ nav.siteTitle }}{% endif %}</title>
		<meta name="description" content="{{ description or nav.siteDescription }}" />
		{%- if moved %}
		<meta name="robots" content="noindex" />
		<link rel="canonical" href="{{ moved.to }}" />
		<meta http-equiv="refresh" content="0; url={{ moved.to | htmlBaseUrl }}" />
		{%- endif %}
		<meta property="og:type" content="website" />
		<meta property="og:title" content="{% if pageTitle %}{{ pageTitle }} — {{ nav.siteTitle }}{% else %}{{ nav.siteTitle }}{% endif %}" />
		<meta property="og:description" content="{{ description or nav.siteDescription }}" />
		<meta property="og:image" content="https://cirthcss.github.io/cirth/social-preview.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Cirth: production-ready UI from semantic HTML, with a verified proof ledger." />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.svg" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/favicon_dark.svg" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="stylesheet" href="/styles/style.css" />
		{#- Page-specific stylesheets, loaded after the shared shell. -#}
		{% for sheet in stylesheets %}<link rel="stylesheet" href="/styles/{{ sheet }}" />{% endfor %}
		<script>
			// Set data-theme before first paint to avoid a light-mode flash.
			(function () {
				var stored = localStorage.getItem("cirth-theme");
				var dark = stored
					? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
			})();

			// The session's preset, before first paint (gh#80).
			(function () {
				var preset = sessionStorage.getItem("cirth-preset");
				if (!preset || preset === "default") return;
				var base = (document.documentElement.getAttribute("data-base") || "/").replace(/\/$/, "");
				var link = document.createElement("link");
				link.rel = "stylesheet";
				link.id = "cirth-preset-stylesheet";
				link.href = base + "/styles/generated/presets/" + preset + ".css";
				document.head.appendChild(link);
			})();
		</script>
	</head>
	<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
		<a href="#main-content" class="sr-only sr-only-focusable docs-skip-link">Skip to main content</a>
		{%- if versions.isNext %}
			{#- Only on the /next/ preview build: a reader arriving from a
			    search result has no other sign that it has not shipped. -#}
			<aside class="docs-next-banner">
				<p>
					<strong>Unreleased documentation.</strong> This is the
					<code>develop</code> branch, not a published version. What it
					describes may change or be dropped before release;
					<a href="{{ page.url | siteRoot }}">read the current documentation</a> instead.
				</p>
			</aside>
		{%- endif %}
		{% include "site-header.njk" %}
		{{ content | safe }}
		{% include "site-footer.njk" %}
		{% include "search-dialog.njk" %}
		<div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-copy-status></div>
		<script>
			// A copy button for every code block the shell owns, announced in
			// the live region above. It copies what is on screen (innerText),
			// so a listing with hidden lines hands over only the visible ones.
			const copyStatus = document.querySelector("[data-copy-status]");
			const announceCopyStatus = (message) => {
				if (!copyStatus) return;
				copyStatus.textContent = "";
				requestAnimationFrame(() => {
					copyStatus.textContent = message;
				});
			};

			// A <pre> inside a live example is part of the example: no button.
			for (const pre of document.querySelectorAll("pre")) {
				if (pre.closest(".docs-demo-preview")) continue;
				if (pre.querySelector(":scope > button.copy")) continue;
				const code = pre.querySelector("code");
				if (!code?.textContent) continue;

				const button = document.createElement("button");
				button.type = "button";
				button.className = "copy";
				button.setAttribute("aria-label", "Copy to clipboard");
				pre.append(button);

				button.addEventListener("click", async () => {
					try {
						await navigator.clipboard.writeText(code.innerText);
						button.classList.add("copied");
						setTimeout(() => button.classList.remove("copied"), 2000);
						announceCopyStatus("Code copied to clipboard.");
					} catch {
						announceCopyStatus("Code could not be copied.");
					}
				});
			}

			// The package manager switch (install.njk) works in CSS alone; this
			// remembers the choice across switches and pages.
			if (document.querySelector("[data-docs-install]")) {
				const applyManager = (value) => {
					for (const input of document.querySelectorAll(
						`[data-docs-install] input[value="${value}"]`,
					)) {
						input.checked = true;
					}
				};
				try {
					const stored = localStorage.getItem("cirth-package-manager");
					if (stored && /^(npm|pnpm|yarn|bun)$/.test(stored)) applyManager(stored);
				} catch {}
				document.addEventListener("change", (event) => {
					const input = event.target;
					if (!(input instanceof HTMLInputElement)) return;
					if (!input.closest("[data-docs-install]")) return;
					applyManager(input.value);
					try {
						localStorage.setItem("cirth-package-manager", input.value);
					} catch {}
				});
			}

			// Header preset switcher (gh#80). The <head> script applies a
			// remembered preset before first paint; one <link> is swapped, so
			// an unvisited preset is never fetched.
			const presetSelect = document.querySelector("[data-cirth-preset-select]");
			if (presetSelect) {
				const base = (document.documentElement.getAttribute("data-base") || "/").replace(/\/$/, "");
				const applyPreset = (preset) => {
					const existing = document.getElementById("cirth-preset-stylesheet");
					if (preset === "default") {
						existing?.remove();
						return;
					}
					const link = existing ?? document.createElement("link");
					link.rel = "stylesheet";
					link.id = "cirth-preset-stylesheet";
					link.href = `${base}/styles/generated/presets/${preset}.css`;
					if (!existing) document.head.appendChild(link);
				};
				presetSelect.value = sessionStorage.getItem("cirth-preset") || "default";
				presetSelect.addEventListener("change", () => {
					sessionStorage.setItem("cirth-preset", presetSelect.value);
					applyPreset(presetSelect.value);
				});
			}
		</script>
	</body>
</html>
