<!doctype html>
<html lang="en" data-base="{{ '/' | htmlBaseUrl }}">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{% if title %}{{ title }} — {{ nav.siteTitle }}{% else %}{{ nav.siteTitle }}{% endif %}</title>
		<meta name="description" content="{{ description or nav.siteDescription }}" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="{% if title %}{{ title }} — {{ nav.siteTitle }}{% else %}{{ nav.siteTitle }}{% endif %}" />
		<meta property="og:description" content="{{ description or nav.siteDescription }}" />
		<meta property="og:image" content="https://cirthcss.github.io/cirth/social-preview.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Cirth: production-ready UI from semantic HTML, with a verified proof ledger." />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.svg" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/favicon_dark.svg" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="stylesheet" href="/styles/style.css" />
		{% if usesClassless %}<link rel="stylesheet" href="/styles/generated/cirth-docs-classless.css" />{% endif %}
		<script>
			// Set data-theme before first paint to avoid a light-mode flash.
			(function () {
				var stored = localStorage.getItem("cirth-theme");
				var dark = stored
					? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
			})();

			// Same idea for the preset switcher (gh#80): apply a
			// session-remembered preset before first paint, so returning to
			// a page (or following a link) after picking one doesn't flash
			// the default theme first. sessionStorage, not localStorage —
			// the issue asks for "the current session", not a permanent
			// choice that'd survive a closed tab into someone's next visit.
			(function () {
				var preset = sessionStorage.getItem("cirth-preset");
				if (!preset || preset === "amber") return;
				var base = (document.documentElement.getAttribute("data-base") || "/").replace(/\/$/, "");
				var link = document.createElement("link");
				link.rel = "stylesheet";
				link.id = "cirth-preset-stylesheet";
				link.href = base + "/styles/generated/presets/" + preset + ".css";
				document.head.appendChild(link);
			})();
		</script>
	</head>
	<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
		<a href="#main-content" class="sr-only sr-only-focusable docs-skip-link">Skip to main content</a>
		{%- if versions.isNext %}
			{#- Only ever rendered on the /next/ preview build. Not a
			    decoration: someone arriving from a search result has no
			    other way to know that what they are reading has not
			    shipped. -#}
			<aside class="docs-next-banner">
				<p>
					<strong>Unreleased documentation.</strong> This is the
					<code>develop</code> branch, not a published version. What it
					describes may change or be dropped before release —
					<a href="{{ page.url | siteRoot }}">read the current documentation</a> instead.
				</p>
			</aside>
		{%- endif %}
		{% include "site-header.njk" %}
		{{ content | safe }}
		{% include "site-footer.njk" %}
		{% include "search-dialog.njk" %}
		<div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-copy-status></div>
		<script>
			// Copy-to-clipboard for fenced code blocks: the markdown pipeline
			// only highlights, it doesn't add a button, so one is injected for
			// every `pre > code` on the page (prose fences and Demo's
			// "Show HTML" source alike).
			const copyStatus = document.querySelector("[data-copy-status]");
			const announceCopyStatus = (message) => {
				if (!copyStatus) return;
				copyStatus.textContent = "";
				requestAnimationFrame(() => {
					copyStatus.textContent = message;
				});
			};

			for (const pre of document.querySelectorAll("pre")) {
				if (pre.querySelector(":scope > button.copy")) continue;
				const code = pre.querySelector("code");
				if (!code?.textContent) continue;

				const button = document.createElement("button");
				button.type = "button";
				button.className = "copy";
				button.setAttribute("aria-label", "Copy to clipboard");
				pre.append(button);

				button.addEventListener("click", async () => {
					try {
						await navigator.clipboard.writeText(code.textContent ?? "");
						button.classList.add("copied");
						setTimeout(() => button.classList.remove("copied"), 2000);
						announceCopyStatus("Code copied to clipboard.");
					} catch {
						announceCopyStatus("Code could not be copied.");
					}
				});
			}

			// The scoped classless build reads data-theme from its own root
			// element (.cirth-classless demos), so mirror the site theme onto
			// every such wrapper whenever it changes.
			const classlessRoots = document.querySelectorAll(".cirth-classless");
			if (classlessRoots.length > 0) {
				const sync = () => {
					const theme = document.documentElement.getAttribute("data-theme");
					for (const root of classlessRoots) root.setAttribute("data-theme", theme ?? "light");
				};
				sync();
				new MutationObserver(sync).observe(document.documentElement, {
					attributeFilter: ["data-theme"],
				});
			}

			// Live preset switcher (gh#80): the <head> script above already
			// applied a remembered choice before first paint; this wires up
			// the header <select> for changes after load. Swapping the
			// stylesheet's href (rather than always keeping one <link> per
			// preset and toggling disabled) means an unvisited preset is
			// never fetched at all.
			const presetSelect = document.querySelector("[data-cirth-preset-select]");
			if (presetSelect) {
				const base = (document.documentElement.getAttribute("data-base") || "/").replace(/\/$/, "");
				const applyPreset = (preset) => {
					const existing = document.getElementById("cirth-preset-stylesheet");
					if (preset === "amber") {
						existing?.remove();
						return;
					}
					const link = existing ?? document.createElement("link");
					link.rel = "stylesheet";
					link.id = "cirth-preset-stylesheet";
					link.href = `${base}/styles/generated/presets/${preset}.css`;
					if (!existing) document.head.appendChild(link);
				};
				presetSelect.value = sessionStorage.getItem("cirth-preset") || "amber";
				presetSelect.addEventListener("change", () => {
					sessionStorage.setItem("cirth-preset", presetSelect.value);
					applyPreset(presetSelect.value);
				});
			}

		</script>
	</body>
</html>
