{#- Installation widgets, shared by the Installation page and the guides.

    packageManagers(id, verb): one command per package manager, chosen with
    native radios (a choice of one, not tabs). The choice is pure CSS
    (`.docs-install:has(:checked)`); base.njk only remembers it.

    Single lines on purpose: markdown-it ends an HTML block at a blank line,
    and whitespace inside <pre> is content. -#}
{%- macro packageManagers(id, args = "@cirthcss/cirth") -%}
<div class="docs-install" data-docs-install>
<fieldset class="docs-choice"><legend>Package manager</legend><label><input type="radio" name="pm-{{ id }}" value="npm" checked> npm</label><label><input type="radio" name="pm-{{ id }}" value="pnpm"> pnpm</label><label><input type="radio" name="pm-{{ id }}" value="yarn"> Yarn</label><label><input type="radio" name="pm-{{ id }}" value="bun"> Bun</label></fieldset>
<pre tabindex="0" data-pm="npm"><code class="hljs language-sh">npm install {{ args }}</code></pre>
<pre tabindex="0" data-pm="pnpm"><code class="hljs language-sh">pnpm add {{ args }}</code></pre>
<pre tabindex="0" data-pm="yarn"><code class="hljs language-sh">yarn add {{ args }}</code></pre>
<pre tabindex="0" data-pm="bun"><code class="hljs language-sh">bun add {{ args }}</code></pre>
</div>
{%- endmacro -%}

{#- A link to the project's site, named "<Project> official website"; its
    images are decorative. A project named by text alone (`textOnly` in
    frameworks.js) gets its address as the link text instead. -#}
{%- macro siteLink(guide, height = 28, className = "docs-guide-site") -%}
{%- if guide.markData -%}
<a class="{{ className }}" href="{{ guide.officialUrl }}" aria-label="{{ guide.name }} official website"><span class="docs-mark">{{ guide.markData | markImages(height) | safe }}</span></a>
{%- else -%}
<a class="{{ className }}" href="{{ guide.officialUrl }}">{{ guide.officialUrl | siteName | replace(".", ".<wbr>") | safe }}</a>
{%- endif -%}
{%- endmacro -%}

{#- Guide tiles: two sibling links, the mark to the project's site and the
    name to the guide, never one inside the other. -#}
{%- macro guideGrid(groups) -%}
<div class="docs-guide-groups">
{%- for group in groups %}
<section aria-labelledby="guides-{{ group.id }}">
<h3 id="guides-{{ group.id }}" class="docs-guide-group-title">{{ group.text }}</h3>
<ul class="docs-guide-grid">
{%- for guide in group.guides %}
<li>{{ siteLink(guide) }}<a class="docs-guide-name" href="{{ guide.link }}">{{ guide.name }}<span class="docs-guide-arrow" aria-hidden="true">→</span></a></li>
{%- endfor %}
</ul>
</section>
{%- endfor %}
</div>
{%- endmacro -%}
