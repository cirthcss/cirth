{%- set defaultSource -%}
<main class="container">
  <article>
    <h2>Sign in</h2>
    <form>
      <label>Email <input type="email"></label>
      <label>Password <input type="password"></label>
      <label><input type="checkbox" checked> Remember me</label>
      <button>Sign in</button>
    </form>
  </article>
</main>
{%- endset -%}

<figure class="docs-transform-figure" aria-label="Semantic HTML source and authentic Cirth output">
	<div class="docs-lab-toolbar">
		<label>
			<span>Build</span>
			<select data-lab-build>
				<option value="default">Default</option>
				<option value="classless">Classless</option>
				<option value="scoped">Scoped</option>
				<option value="scoped-classless">Scoped + classless</option>
			</select>
		</label>
		<label>
			<span>Theme</span>
			<select data-lab-theme>
				<option value="light">Light</option>
				<option value="dark">Dark</option>
			</select>
		</label>
	</div>
	<div class="docs-transform-grid">
		<section class="docs-source-panel" aria-labelledby="source-label">
			<header>
				<span id="source-label">Source</span>
			</header>
			<pre tabindex="0"><code data-lab-source>{{ defaultSource }}</code></pre>
		</section>

		<section class="docs-output-panel" aria-labelledby="output-label">
			<header>
				<span id="output-label">Output</span>
			</header>
			<iframe
				title="Authentic Cirth default build rendering a semantic sign-in form"
				src="/lab/default/?theme=light"
				data-lab-frame
				loading="eager"
			></iframe>
		</section>
	</div>
	<p class="docs-figure-note">
		<strong>Docs controls use JavaScript.</strong>
		The output has no preview overrides.
	</p>
</figure>

<script>
	(() => {
		const build = document.querySelector("[data-lab-build]");
		const theme = document.querySelector("[data-lab-theme]");
		const frame = document.querySelector("[data-lab-frame]");
		const source = document.querySelector("[data-lab-source]");
		if (!build || !theme || !frame || !source) return;

		const sources = {
			default: `<main class="container">
  <article>
    <h2>Sign in</h2>
    <form>…native controls…</form>
  </article>
</main>`,
			classless: `<main>
  <article>
    <h2>Sign in</h2>
    <form>…native controls…</form>
  </article>
</main>`,
			scoped: `<div class="cirth">
  <main class="container">
    <article>…native controls…</article>
  </main>
</div>`,
			"scoped-classless": `<div class="cirth">
  <main>
    <article>…native controls…</article>
  </main>
</div>`,
		};
		const render = () => {
			const base = (document.documentElement.dataset.base || "/").replace(/\/$/, "");
			frame.src = `${base}/lab/${build.value}/?theme=${theme.value}`;
			frame.title = `Authentic Cirth ${build.options[build.selectedIndex].text} build in ${theme.value} mode`;
			source.textContent = sources[build.value];
		};

		build.addEventListener("change", render);
		theme.addEventListener("change", render);
		theme.value = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
		render();
	})();
</script>
