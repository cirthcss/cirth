{#- Source → Output, in two cards that overlap.

    The argument this page makes is one move long: semantic HTML on the
    left, the interface Cirth renders from it on the right, close enough
    together that the eye reads them as one object. Everything here is in
    service of that and nothing else.

    What the composition deliberately does not have: a per-character
    reveal, an erase cycle, a rAF scheduler, output elements gated on
    offsets found in the source text, an IntersectionObserver, a
    focus/selection settler, and a `window` test surface to drive it all.
    The write-in is a CSS wipe (docs/src/styles/style.css), so the whole
    snippet is in the DOM and complete at every frame — selection, copy,
    assistive technology and no-JS see the same finished source they
    always did, and the panel cannot reflow because nothing about it
    changes. The script below is what is genuinely left: the two build
    and theme controls, which are the one thing here that needs
    JavaScript. -#}
<div class="docs-lab-stage">
	<section class="docs-plate docs-source-panel" aria-labelledby="source-label">
		<header>
			<span id="source-label">Source</span>
			<label>Build <select data-lab-build>
				<option value="default">Default</option>
				<option value="classless">Classless</option>
				<option value="scoped">Scoped</option>
				<option value="scoped-classless">Scoped + classless</option>
			</select></label>
		</header>
		<pre tabindex="0"><code class="hljs language-html" data-lab-source>{{ labSources.default | highlightHtml | safe }}</code></pre>
		{#- Every variant, highlighted at build time. The switcher moves
		    markup between these and the <code> above; nothing is
		    highlighted in the browser. -#}
		{% for name, source in labSources %}<template data-lab-source-for="{{ name }}">{{ source | highlightHtml | safe }}</template>{% endfor %}
	</section>

	<section class="docs-plate docs-output-panel" aria-labelledby="output-label">
		<header>
			<span id="output-label">Output</span>
			<label>Theme <select data-lab-theme>
				<option value="light">Light</option>
				<option value="dark">Dark</option>
			</select></label>
		</header>
		<div class="docs-output-frame">
			<iframe
				title="Authentic Cirth default build rendering a semantic sign-in form"
				src="/lab/default/?theme=light"
				data-lab-frame
				loading="eager"
			></iframe>
		</div>
	</section>
</div>
<p class="docs-figure-note">
	<strong>Docs controls use JavaScript.</strong>
	The output has no preview overrides.
</p>

<script>
	(() => {
		const build = document.querySelector("[data-lab-build]");
		const theme = document.querySelector("[data-lab-theme]");
		const frame = document.querySelector("[data-lab-frame]");
		const source = document.querySelector("[data-lab-source]");
		if (!build || !theme || !frame || !source) return;

		// The <template>s hold every variant already highlighted at build
		// time, so there is still exactly one copy of the sources in this
		// project (docs/src/_data/labSources.js) and nothing is highlighted
		// in the browser.
		const applySource = () => {
			const variant = document.querySelector(
				`[data-lab-source-for="${build.value}"]`,
			);
			// innerHTML, not textContent: the payload is the build-time
			// highlighted markup from the matching <template>, not user input.
			if (variant) source.innerHTML = variant.innerHTML;
		};

		const applyFrame = () => {
			const base = (document.documentElement.dataset.base || "/").replace(/\/$/, "");
			frame.src = `${base}/lab/${build.value}/?theme=${theme.value}`;
			frame.title = `Authentic Cirth ${build.options[build.selectedIndex].text} build in ${theme.value} mode`;
		};

		build.addEventListener("change", () => {
			applySource();
			applyFrame();
		});
		theme.addEventListener("change", applyFrame);

		theme.value = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
		applyFrame();
	})();
</script>
