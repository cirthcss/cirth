{#- The footer follows the page's scheme, as the header does. -#}
<footer class="docs-footer">
	<div class="container">
		<div class="docs-footer-top">
			<div>
				<a href="/" class="contrast docs-brand docs-footer-brand">
					<img class="docs-logo docs-logo-light" src="/logo_brand.svg" alt="" width="36" height="36" />
					<img class="docs-logo docs-logo-dark" src="/logo_brand_dark.svg" alt="" width="36" height="36" />
					<strong>{{ nav.siteTitle }}</strong>
				</a>
				<p class="docs-footer-tagline">Semantic HTML in. Finished UI out.</p>
				<p class="docs-footer-credit">
					Designed and built by Riccardo Pastori, with help from the
					<a href="https://github.com/cirthcss/cirth/graphs/contributors" target="_blank" rel="noreferrer">contributors<span class="docs-external-mark" aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a>.
				</p>
			</div>
			<nav class="docs-footer-columns" aria-label="Footer">
				{% for group in nav.footerLinks %}
					<div class="docs-footer-column">
						<h2>{{ group.title }}</h2>
						<ul>
							{% for item in group.items %}
								<li>
									{% if item.link.startsWith("http") %}
										<a href="{{ item.link }}" target="_blank" rel="noreferrer">{{ item.text }}<span class="docs-external-mark" aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a>
									{% else %}
										<a href="{{ item.link }}">{{ item.text }}</a>
									{% endif %}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endfor %}
			</nav>
		</div>
		<div class="docs-footer-legal">
			<small><a href="https://github.com/cirthcss/cirth/blob/master/LICENSE.md">{{ nav.footer.message }}</a></small>
			<small>{{ nav.footer.copyright }}</small>
		</div>
	</div>
</footer>
