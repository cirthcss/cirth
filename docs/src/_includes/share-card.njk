<!doctype html>
<html lang="en" data-theme="{{ cardTheme }}" data-card-theme="{{ cardTheme }}" data-card-format="{{ cardFormat }}">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Cirth {{ cardFormat }} brand asset</title>
		<!-- Relative, not absolute: these three pages are rasterised straight
		     from docs/dist over file:// by scripts/capture-brand-assets.js,
		     which has no server to resolve a root-relative path. The logo
		     below is referenced the same way for the same reason. -->
		<link rel="stylesheet" href="../styles/generated/cirth-docs.css" />
		<style>
			* { box-sizing: border-box; }
			html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
			/* The card's composition vocabulary comes from the framework's
			   tokens rather than a separate palette that could drift from Cirth.
			   data-theme on <html> is what the stylesheet's own scheme wiring
			   reads, so the dark card needs no second block here. */
			body {
				--paper: var(--cirth-canvas);
				--board: var(--cirth-card-background-color);
				--ink: var(--cirth-ink);
				--muted: var(--cirth-muted-color);
				--line: var(--cirth-form-element-border-color);
				--signal: var(--cirth-primary-text);
				display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: 24px; padding: 48px; background: var(--paper); color: var(--ink);
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				/* The card takes the palette from the stylesheet above but not
				   its reading rhythm: this is a fixed-size raster whose line
				   breaks are part of the composition, so the leading is pinned
				   here rather than following --cirth-line-height. */
				line-height: 1.2;
			}
			.brand { position: relative; grid-column: 1 / span 5; display: flex; flex-direction: column; }
			/* The lockup file itself, not a re-typeset name beside the mark. */
			.lockup { display: block; width: 220px; height: auto; }
			h1 { max-width: 8ch; margin: auto 0 0; font-size: 82px; line-height: .88; letter-spacing: -.065em; }
			h1 em { color: var(--signal); font-style: normal; }
			.tag { margin: 24px 0 0; color: var(--muted); font-size: 22px; }
			/* The card's grid places both columns; the library's flow between
			   sibling sections would push this one down. */
			.board { position: relative; grid-column: 6 / -1; display: grid; grid-template-rows: auto 1fr auto;
				margin: 0; border: 1px solid var(--line); background: var(--board); }
			.board-head { display: flex; justify-content: space-between; padding: 14px 48px 14px 18px; border-bottom: 1px solid var(--line);
				color: var(--muted); font-size: 14px; font-weight: 600; line-height: 1; }
			.flow { display: grid; grid-template-columns: 1fr 90px 1fr; align-items: stretch; }
			.node { display: grid; place-content: center; gap: 14px; padding: 24px; }
			/* Bare, not the library's inline-code chip: inside the card a code
			   fragment is a specimen of markup, not a token mentioned in prose. */
			.node code { padding: 0; background: none; color: var(--signal);
				font: 700 16px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
			.node strong { font-size: 24px; }
			.connector { position: relative; display: grid; place-items: center; border-inline: 1px solid var(--line); color: var(--muted);
				font-size: 12px; font-weight: 600; line-height: 1.3; text-align: center; }
			.connector::before { position: absolute; inset-inline: 0; top: 50%; border-top: 2px solid var(--signal); content: ""; }
			.connector span { position: relative; padding: 8px; background: var(--board); }
			.ledger { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
			.proof { display: grid; gap: 5px; padding: 15px 18px; border-right: 1px solid var(--line); }
			.proof:last-child { border: 0; }
			.proof small { color: var(--muted); font-size: 12px; font-weight: 600; line-height: 1; }
			.proof strong { font-size: 14px; }

			[data-card-format="readme"] body { gap: 20px; padding: 24px 32px; }
			[data-card-format="readme"] .brand { grid-column: 1 / span 5; }
			[data-card-format="readme"] .lockup { width: 140px; }
			[data-card-format="readme"] h1 { max-width: none; margin: auto 0; font-size: 44px; line-height: .92; }
			[data-card-format="readme"] .tag { margin: 0; font-size: 14px; }
			[data-card-format="readme"] .board { grid-column: 6 / -1; grid-template-rows: auto 1fr; }
			[data-card-format="readme"] .flow { display: none; }
			[data-card-format="readme"] .ledger { grid-template-columns: repeat(2, 1fr); border-top: 0; }
			[data-card-format="readme"] .proof { align-content: center; border-bottom: 1px solid var(--line); }
			[data-card-format="readme"] .proof:nth-child(3), [data-card-format="readme"] .proof:nth-child(4) { border-bottom: 0; }
		</style>
	</head>
	<body>
		<section class="brand">
			{#- The README card draws the lockup 140px wide, its badge under 64px:
			    the size the compact drawing is for. -#}
			{%- set lockupFile = "wordmark_compact" if cardFormat == "readme" else "wordmark" -%}
			<img class="lockup" src="../{{ lockupFile }}{% if cardTheme == 'dark' %}_dark{% endif %}.svg" alt="Cirth" />
			<h1>UI from <em>semantic HTML.</em></h1>
			<p class="tag">One stylesheet. Accessible baseline. No runtime.</p>
		</section>
		<section class="board">
			<header class="board-head"><span>Source → output</span><span>Verified build</span></header>
			<div class="flow">
				<div class="node"><code>&lt;article&gt;<br />&nbsp;&nbsp;&lt;form&gt;</code><strong>HTML carries intent.</strong></div>
				<div class="connector"><span>Cirth</span></div>
				<div class="node"><code>native / themed</code><strong>Production-ready UI.</strong></div>
			</div>
			<div class="ledger">
				<div class="proof"><small>Semantic</small><strong>HTML first</strong></div>
				<div class="proof"><small>Baseline</small><strong>WCAG 2.2 AA</strong></div>
				<div class="proof"><small>Runtime</small><strong>0 B JavaScript</strong></div>
				<div class="proof"><small>Measured</small><strong>{{ proof.size.label }} gzip · {{ proof.tokenCount }} tokens</strong></div>
			</div>
		</section>
	</body>
</html>
