<!doctype html>
<html lang="en" data-card-theme="{{ cardTheme }}" data-card-format="{{ cardFormat }}">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Cirth {{ cardFormat }} brand asset</title>
		<style>
			* { box-sizing: border-box; }
			html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
			body {
				--paper: #f8f6f3; --board: #fffdfa; --ink: #202126; --muted: #666b76;
				--line: #ccd0d8; --signal: #a56818; --signal-soft: #f2dfbd;
				display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: 24px; padding: 48px; background: var(--paper); color: var(--ink);
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			}
			[data-card-theme="dark"] body {
				--paper: #17181a; --board: #1e2024; --ink: #f0f1f3; --muted: #a4a9b4;
				--line: #3b3e46; --signal: #dc8e18; --signal-soft: #3e301b;
			}
			body::before { position: absolute; inset: 0; content: ""; opacity: .5;
				background-image: radial-gradient(circle, var(--line) 1px, transparent 1px);
				background-size: 16px 16px; mask-image: linear-gradient(120deg, #000, transparent 65%); }
			.brand { position: relative; grid-column: 1 / span 5; display: flex; flex-direction: column; }
			.lockup { display: flex; align-items: center; gap: 16px; color: var(--muted);
				font: 700 13px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; }
			.lockup img { width: 72px; height: 72px; }
			h1 { max-width: 8ch; margin: auto 0 0; font-size: 82px; line-height: .88; letter-spacing: -.065em; }
			h1 em { color: var(--signal); font-style: normal; }
			.tag { margin: 24px 0 0; color: var(--muted); font-size: 22px; }
			.board { position: relative; grid-column: 6 / -1; display: grid; grid-template-rows: auto 1fr auto;
				border: 1px solid var(--line); background: var(--board); box-shadow: 12px 12px 0 var(--signal-soft); }
			.board::after { position: absolute; top: -1px; right: -1px; width: 36px; height: 36px; content: "";
				background: linear-gradient(135deg, transparent 48%, var(--line) 50%, var(--paper) 52%); }
			.board-head { display: flex; justify-content: space-between; padding: 14px 48px 14px 18px; border-bottom: 1px solid var(--line);
				color: var(--muted); font: 700 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .08em; text-transform: uppercase; }
			.flow { display: grid; grid-template-columns: 1fr 90px 1fr; align-items: stretch; }
			.node { display: grid; place-content: center; gap: 14px; padding: 24px; }
			.node code { color: var(--signal); font: 700 16px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
			.node strong { font-size: 24px; }
			.connector { position: relative; display: grid; place-items: center; border-inline: 1px solid var(--line); color: var(--muted);
				font: 700 10px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; text-align: center; text-transform: uppercase; }
			.connector::before { position: absolute; inset-inline: 0; top: 50%; border-top: 2px solid var(--signal); content: ""; }
			.connector span { position: relative; padding: 8px; background: var(--board); }
			.ledger { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
			.proof { display: grid; gap: 5px; padding: 15px 18px; border-right: 1px solid var(--line); }
			.proof:last-child { border: 0; }
			.proof small { color: var(--muted); font: 700 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; }
			.proof strong { font-size: 14px; }

			[data-card-format="readme"] body { gap: 20px; padding: 24px 32px; }
			[data-card-format="readme"] .brand { grid-column: 1 / span 5; }
			[data-card-format="readme"] .lockup img { width: 44px; height: 44px; }
			[data-card-format="readme"] h1 { max-width: none; margin: auto 0; font-size: 44px; line-height: .92; }
			[data-card-format="readme"] .tag { margin: 0; font-size: 14px; }
			[data-card-format="readme"] .board { grid-column: 6 / -1; grid-template-rows: auto 1fr; box-shadow: 8px 8px 0 var(--signal-soft); }
			[data-card-format="readme"] .flow { display: none; }
			[data-card-format="readme"] .ledger { grid-template-columns: repeat(2, 1fr); border-top: 0; }
			[data-card-format="readme"] .proof { align-content: center; border-bottom: 1px solid var(--line); }
			[data-card-format="readme"] .proof:nth-child(3), [data-card-format="readme"] .proof:nth-child(4) { border-bottom: 0; }
		</style>
	</head>
	<body>
		<section class="brand">
			<div class="lockup">
				<img src="../{% if cardTheme == 'dark' %}logo_brand_dark.svg{% else %}logo_brand.svg{% endif %}" alt="" />
				<span>Cirth / Native baseline</span>
			</div>
			<h1>UI from <em>semantic HTML.</em></h1>
			<p class="tag">One stylesheet. Accessible baseline. No runtime.</p>
		</section>
		<section class="board">
			<header class="board-head"><span>Fig. 01 / source → output</span><span>Verified build</span></header>
			<div class="flow">
				<div class="node"><code>&lt;article&gt;<br />&nbsp;&nbsp;&lt;form&gt;</code><strong>HTML carries intent.</strong></div>
				<div class="connector"><span>Cirth<br />CSS</span></div>
				<div class="node"><code>native / themed</code><strong>Production-ready UI.</strong></div>
			</div>
			<div class="ledger">
				<div class="proof"><small>✓ semantic</small><strong>HTML first</strong></div>
				<div class="proof"><small>✓ baseline</small><strong>WCAG 2.2 AA</strong></div>
				<div class="proof"><small>● runtime</small><strong>0 B JavaScript</strong></div>
				<div class="proof"><small>● budget</small><strong>&lt;14 KB gzip · {{ proof.tokenCount }} tokens</strong></div>
			</div>
		</section>
	</body>
</html>
