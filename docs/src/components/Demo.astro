---
// Live example + "Show HTML" source, exactly like the old Demo.vue: the
// raw HTML snippet is read at build time via Vite's `?raw` import glob
// (Astro is built on Vite) and injected both rendered and as literal text.
// Zero client JS — the <details> disclosure is native.
interface Props {
	src: string;
	/** "default" previews under the site-wide default build; "classless"
	 * previews under the scoped classless build so its landmark/container
	 * behavior renders accurately. */
	variant?: "default" | "classless";
}
const { src, variant = "default" } = Astro.props;

const modules = import.meta.glob("../content/demos/*.html", {
	query: "?raw",
	import: "default",
	eager: true,
}) as Record<string, string>;

const html = (modules[`../content/demos/${src}.html`] ?? "").trim();
if (!html) {
	console.warn(`[Demo] missing snippet: ${src}.html`);
}
---

<div class="docs-demo">
	<div
		class="docs-demo-preview"
		class:list={[variant === "classless" && "cirth-classless"]}
		set:html={html}
	/>
	<details class="docs-demo-source">
		<summary>Show HTML</summary>
		<pre tabindex="0"><code set:text={html} /></pre>
	</details>
</div>
